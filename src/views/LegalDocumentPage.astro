---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLocale, localizePath } from '../i18n/utils';
import { getLegalDoc, type LegalDocId } from '../i18n/legal';

interface Props {
  doc: LegalDocId;
}

const { doc } = Astro.props;
const locale = getLocale(Astro.currentLocale);
const content = getLegalDoc(locale, doc);
const seeAlsoHref = localizePath(locale, content.seeAlsoHref);
---

<BaseLayout title={content.metaTitle} description={content.metaDescription}>
  <Navbar />

  <main class="legal">
    <article class="legal__doc">
      <header class="legal__header">
        <p class="legal__brand">{content.brand}</p>
        <h1 class="legal__title">{content.title}</h1>
        <p class="legal__updated">{content.updated}</p>
        <p class="legal__see-also">
          {content.seeAlsoLabel}:{' '}
          <a href={seeAlsoHref} class="legal__see-also-link">{content.seeAlsoText}</a>
        </p>
      </header>

      {content.intro && <p class="legal__intro">{content.intro}</p>}

      {content.sections.map((section) => {
        const isPart = section.blocks.length === 0;
        return (
          <section class:list={['legal__section', isPart && 'legal__section--part']}>
            <h2 class:list={['legal__heading', isPart && 'legal__heading--part']}>{section.heading}</h2>
            {section.blocks.map((block) =>
              block.type === 'p' ? (
                <p class="legal__p">{block.text}</p>
              ) : (
                <ul class="legal__ul">
                  {block.items.map((item) => (
                    <li class="legal__li">{item}</li>
                  ))}
                </ul>
              )
            )}
          </section>
        );
      })}

      <footer class="legal__company">
        <p>{content.companyLine}</p>
      </footer>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .legal {
    background: #f6f1e8;
    padding: clamp(48px, 8vw, 80px) 24px clamp(64px, 10vw, 112px);
  }

  .legal__doc {
    max-width: 720px;
    margin-inline: auto;
    background: #fdfbf7;
    border: 1px solid #e7dfd2;
    border-radius: 16px;
    padding: clamp(28px, 5vw, 48px) clamp(22px, 4vw, 44px);
    box-shadow: 0 18px 40px -28px rgba(28, 42, 67, 0.28);
  }

  .legal__header {
    text-align: center;
    margin-bottom: 36px;
    padding-bottom: 28px;
    border-bottom: 1px solid #efe8db;
  }

  .legal__brand {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 15px;
    font-weight: 600;
    color: #b8934a;
    letter-spacing: 0.04em;
    margin: 0 0 10px;
  }

  .legal__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    line-height: 1.15;
    color: #1c2a43;
    margin: 0 0 12px;
  }

  .legal__updated {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    color: #7a7263;
    margin: 0 0 14px;
  }

  .legal__see-also {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13.5px;
    color: #8a7f6b;
    margin: 0;
  }

  .legal__see-also-link {
    color: #1c2a43;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal__see-also-link:hover {
    color: #b8934a;
  }

  .legal__intro {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #4a4438;
    margin: 0 0 32px;
  }

  .legal__section {
    margin-bottom: 28px;
  }

  .legal__section--part {
    margin-top: 40px;
    margin-bottom: 18px;
    padding-top: 28px;
    border-top: 1px solid #efe8db;
  }

  .legal__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.3;
    color: #1c2a43;
    margin: 0 0 12px;
  }

  .legal__heading--part {
    font-size: 1.35rem;
    margin-bottom: 0;
  }

  .legal__p {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #4a4438;
    margin: 0 0 12px;
  }

  .legal__ul {
    margin: 0 0 12px;
    padding-left: 1.15em;
    list-style: disc;
  }

  .legal__li {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    line-height: 1.65;
    color: #4a4438;
    margin-bottom: 6px;
    padding-left: 0.2em;
  }

  .legal__company {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid #efe8db;
  }

  .legal__company p {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12.5px;
    line-height: 1.55;
    color: #8a7f6b;
    margin: 0;
    text-align: center;
  }
</style>
