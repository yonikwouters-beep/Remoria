---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLocale, t, tp, localizePath } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);

type ValueCard = { title: string; desc: string };
type AudienceItem = { eyebrow: string; title: string; body: string; cta: string };

const missionParagraphs = tp<string[]>(locale, 'overOns.mission.paragraphs');
const valueCards = tp<ValueCard[]>(locale, 'overOns.values.cards');
const audienceItems = tp<AudienceItem[]>(locale, 'overOns.audience');

const startUrl = localizePath(locale, '/prijzen');
const demoUrl = 'https://remoria.eu/demo';
const audienceLinks = [
  localizePath(locale, '/voor-nabestaanden'),
  localizePath(locale, '/voor-uitvaartsector'),
];
const audienceBgs = [
  '/over-ons-voor-nabestaanden.webp',
  '/voor-uitvaartprofessionals.webp',
];

const valueCardIcons = [
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 6.1H3"/><path d="M21 12.1H3"/><path d="M15.1 18H3"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
];
---

<BaseLayout title={t(locale, 'overOns.meta.title')} description={t(locale, 'overOns.meta.description')}>
  <Navbar />

  <main class="about-page">

    <!-- Hero -->
    <section class="hero" aria-labelledby="hero-heading">
      <div class="container hero__grid">
        <div class="hero__content" data-reveal>
          <p class="eyebrow">{t(locale, 'overOns.hero.eyebrow')}</p>
          <h1 class="hero__title" id="hero-heading">{t(locale, 'overOns.hero.title')}</h1>
          <div class="hero__quote-row">
            <span class="hero__quote-bar" aria-hidden="true"></span>
            <p class="hero__quote">{t(locale, 'overOns.hero.quote')}</p>
          </div>
        </div>
        <div class="hero__visual" data-reveal data-reveal-delay="80">
          <img
            src="/family-album-about-us.webp"
            alt={t(locale, 'overOns.hero.imageAlt')}
            class="hero__img"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <!-- Mission / story card -->
    <section class="mission" id="missie" aria-labelledby="mission-heading">
      <div class="container">
        <div class="mission__card" data-reveal>
          <div class="mission__text">
            <p class="eyebrow">{t(locale, 'overOns.mission.eyebrow')}</p>
            <h2 class="mission__title" id="mission-heading">{t(locale, 'overOns.mission.title')}</h2>
            {missionParagraphs.map((para) => (
              <p class="mission__body">{para}</p>
            ))}
            <p class="mission__closing">{t(locale, 'overOns.mission.closing')}</p>
            <p class="mission__signature">{t(locale, 'overOns.mission.signature')}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Values -->
    <section class="values" aria-labelledby="values-heading">
      <div class="container">
        <div class="values__intro" data-reveal>
          <p class="eyebrow eyebrow--center">{t(locale, 'overOns.values.eyebrow')}</p>
          <h2 class="values__title" id="values-heading">{t(locale, 'overOns.values.title')}</h2>
          <p class="values__sub">{t(locale, 'overOns.values.sub')}</p>
        </div>
        <div class="values__grid">
          {valueCards.map((card, i) => (
            <article class="val-card" data-reveal data-reveal-delay={String(i * 60)}>
              <span class="val-card__icon" aria-hidden="true" set:html={valueCardIcons[i]} />
              <div>
                <h3 class="val-card__title">{card.title}</h3>
                <p class="val-card__desc">{card.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA band -->
    <section class="cta-band" aria-labelledby="cta-heading">
      <div class="container">
        <div class="cta-band__inner" data-reveal>
          <h2 class="cta-band__title" id="cta-heading">{t(locale, 'overOns.cta.title')}</h2>
          <p class="cta-band__sub">{t(locale, 'overOns.cta.sub')}</p>
          <div class="cta-band__actions">
            <a href={startUrl} class="btn btn--gold">
              {t(locale, 'overOns.cta.primary')}
            </a>
            <a href={demoUrl} class="btn btn--outline-light" target="_blank" rel="noopener noreferrer">
              {t(locale, 'overOns.cta.secondary')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Audience cards -->
    <section class="audience" aria-label={t(locale, 'overOns.audienceSectionLabel')}>
      <div class="container audience__grid">
        {audienceItems.map((item, i) => (
          <a
            href={audienceLinks[i]}
            class:list={['aud-card', i === 0 ? 'aud-card--warm' : 'aud-card--cool']}
            style={`--aud-bg: url('${audienceBgs[i]}')`}
            data-reveal
            data-reveal-delay={String(i * 80)}
          >
            <p class:list={['aud-card__eyebrow', i === 1 && 'aud-card__eyebrow--cool']}>{item.eyebrow}</p>
            <h3 class="aud-card__title">{item.title}</h3>
            <p class="aud-card__body">{item.body}</p>
            <span class="aud-card__link">
              {item.cta}
              <span aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<script>
  (function () {
    const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = el.dataset.revealDelay ? parseInt(el.dataset.revealDelay) : 0;
            setTimeout(() => el.classList.add('is-visible'), delay);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.12 }
    );
    elements.forEach((el) => observer.observe(el));
  })();
</script>

<style>
  .about-page {
    font-family: 'Nunito Sans', sans-serif;
    background: #F6F1E8;
    color: #4A4438;
  }

  .container {
    max-width: 1140px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #B8934A;
    margin: 0 0 16px;
  }

  .eyebrow--center {
    text-align: center;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    font-weight: 800;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .btn--gold {
    background: #D9B36A;
    color: #1C2A43;
  }

  .btn--gold:hover {
    background: #E3C285;
    color: #1C2A43;
  }

  .btn--outline-light {
    background: transparent;
    color: #fff;
    font-weight: 700;
    border: 1.5px solid rgba(255, 255, 255, 0.45);
    padding: 14px 26px;
  }

  .btn--outline-light:hover {
    border-color: #fff;
    color: #fff;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* Hero */
  .hero {
    background: linear-gradient(180deg, #F1E9D9, rgba(241, 233, 217, 0));
    padding-bottom: 8px;
  }

  .hero__grid {
    max-width: 1180px;
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: 72px;
    align-items: center;
    padding-block: 64px 72px;
  }

  .hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2.25rem, 4.5vw, 50px);
    line-height: 1.12;
    color: #1C2A43;
    margin: 0 0 24px;
    text-wrap: pretty;
  }

  .hero__quote-row {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    max-width: 460px;
  }

  .hero__quote-bar {
    flex-shrink: 0;
    width: 3px;
    align-self: stretch;
    border-radius: 2px;
    background: #D9B36A;
  }

  .hero__quote {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 21px;
    line-height: 1.5;
    color: #7A7263;
    margin: 0;
  }

  .hero__visual {
    justify-self: end;
    width: 100%;
    max-width: 430px;
  }

  .hero__img {
    width: 100%;
    aspect-ratio: 4 / 4.4;
    object-fit: cover;
    display: block;
    border-radius: 215px 215px 20px 20px;
    box-shadow: 0 24px 50px -24px rgba(28, 42, 67, 0.35);
  }

  /* Mission */
  .mission {
    padding-block: 0 0;
  }

  .mission__card {
    background: #FDF9F1 url('/over-ons-verbinding-na-het-afscheid.webp') right center / cover no-repeat;
    border-radius: 24px;
    box-shadow: 0 18px 40px -20px rgba(28, 42, 67, 0.18);
    padding: 64px 60px;
  }

  .mission__text {
    max-width: 470px;
  }

  .mission__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 34px);
    line-height: 1.18;
    color: #1C2A43;
    margin: 0 0 22px;
    text-wrap: pretty;
  }

  .mission__body {
    font-size: 15.5px;
    line-height: 1.75;
    color: #5C5548;
    margin: 0 0 16px;
  }

  .mission__closing {
    font-size: 16px;
    line-height: 1.7;
    font-weight: 700;
    color: #1C2A43;
    margin: 0 0 20px;
  }

  .mission__signature {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic;
    font-size: 16px;
    color: #B8934A;
    margin: 0;
  }

  /* Values */
  .values {
    padding-block: 88px 0;
  }

  .values__intro {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 48px;
  }

  .values__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2rem, 3.5vw, 40px);
    line-height: 1.15;
    color: #1C2A43;
    margin: 0 0 14px;
  }

  .values__sub {
    font-size: 16px;
    line-height: 1.65;
    color: #7A7263;
    margin: 0;
  }

  .values__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  .val-card {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 16px;
    padding: 30px;
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .val-card__icon {
    display: inline-flex;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: #F3E7CF;
    color: #96742F;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .val-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 19px;
    font-weight: 600;
    color: #1C2A43;
    margin: 0 0 7px;
  }

  .val-card__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: #7A7263;
    margin: 0;
  }

  /* CTA band */
  .cta-band {
    padding-block: 88px 0;
  }

  .cta-band__inner {
    background: linear-gradient(90deg, #1C2A43 40%, rgba(28, 42, 67, 0.55)),
      url('/over-ons-verbinding-na-het-afscheid.webp') right center / cover no-repeat;
    background-color: #1C2A43;
    border-radius: 24px;
    padding: 64px 60px;
    box-shadow: 0 18px 40px -20px rgba(28, 42, 67, 0.35);
  }

  .cta-band__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 34px);
    line-height: 1.2;
    color: #fff;
    margin: 0 0 14px;
    max-width: 520px;
    text-wrap: pretty;
  }

  .cta-band__sub {
    font-size: 16px;
    line-height: 1.7;
    color: #CEC5B0;
    margin: 0 0 28px;
    max-width: 520px;
  }

  .cta-band__actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Audience */
  .audience {
    padding-block: 88px 96px;
  }

  .audience__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 400px), 1fr));
    gap: 20px;
  }

  .aud-card {
    text-decoration: none;
    border-radius: 20px;
    padding: 36px 34px;
    display: block;
    min-height: 240px;
    box-sizing: border-box;
    transition: box-shadow 0.25s ease;
  }

  .aud-card--warm {
    background:
      linear-gradient(90deg, #F4EDE1 55%, rgba(244, 237, 225, 0.85) 72%, rgba(244, 237, 225, 0) 92%),
      var(--aud-bg) right center / cover no-repeat #F4EDE1;
  }

  .aud-card--cool {
    background:
      linear-gradient(90deg, #EFEBE2 55%, rgba(239, 235, 226, 0.85) 72%, rgba(239, 235, 226, 0) 92%),
      var(--aud-bg) right center / cover no-repeat #EFEBE2;
  }

  .aud-card:hover {
    box-shadow: 0 16px 36px -18px rgba(28, 42, 67, 0.3);
  }

  .aud-card__eyebrow {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 2px;
    color: #96742F;
    text-transform: uppercase;
    margin: 0 0 12px;
  }

  .aud-card__eyebrow--cool {
    color: #4A6E8C;
  }

  .aud-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 24px;
    font-weight: 600;
    color: #1C2A43;
    margin: 0 0 10px;
    max-width: 320px;
  }

  .aud-card__body {
    font-size: 14.5px;
    line-height: 1.65;
    color: #6B6353;
    margin: 0 0 20px;
    max-width: 320px;
  }

  .aud-card__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14.5px;
    font-weight: 800;
    color: #1C2A43;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
      padding-block: 48px 56px;
    }

    .hero__visual {
      justify-self: center;
      max-width: 360px;
    }

    .mission__card {
      padding: 40px 28px;
      background-position: 70% center;
    }

    .values__grid {
      grid-template-columns: 1fr;
    }

    .cta-band__inner {
      padding: 40px 28px;
      background:
        linear-gradient(180deg, #1C2A43 45%, rgba(28, 42, 67, 0.72)),
        url('/over-ons-verbinding-na-het-afscheid.webp') center / cover no-repeat;
    }
  }

  @media (max-width: 600px) {
    .hero__quote {
      font-size: 18px;
    }

    .hero__img {
      border-radius: 160px 160px 16px 16px;
    }

    .aud-card {
      min-height: 0;
      padding: 28px 24px;
    }
  }
</style>
