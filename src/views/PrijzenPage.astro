---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import PricingCard from '../components/PricingCard.astro';
import Footer from '../components/Footer.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { getLocale, t, tp } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);

type PlanItem = {
  imageAlt: string;
  title: string;
  duration: string;
  price: string;
  monthlyPrice: string;
  description: string;
  featured: boolean;
};

type ExtItem = { period: string; price: string };
type FeatItem = { title: string; desc: string };
type FaqItem = { question: string; answer: string };

const planImages = [
  '/Kiempje-remoria.png',
  '/jonge-boom-remoria.png',
  '/Groteboom-remoria.png',
];
const startUrls = [
  'https://remoria.eu/start?plan=starter',
  'https://remoria.eu/start?plan=standard',
  'https://remoria.eu/start?plan=premium',
];

const planData = tp<PlanItem[]>(locale, 'prijzen.plans');
const plans = planData.map((p, i) => ({
  ...p,
  image: planImages[i],
  startUrl: startUrls[i],
}));

const trustItems = tp<string[]>(locale, 'prijzen.trust');
const extensions = tp<ExtItem[]>(locale, 'prijzen.extensions.items');
const featItems = tp<FeatItem[]>(locale, 'prijzen.features.items');
const pricingFaqs = tp<FaqItem[]>(locale, 'prijzen.faqs.items');

const trustIcons = [
  `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B8934A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
  `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B8934A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg>`,
  `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B8934A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>`,
  `<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B8934A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
];

const featureIcons = [
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
];

const features = featItems.map((f, i) => ({ ...f, icon: featureIcons[i] }));
const referralUrl = 'https://remoriaeu-4cbb.endorsely.com';
---

<BaseLayout title={t(locale, 'prijzen.meta.title')} description={t(locale, 'prijzen.meta.description')}>
  <Navbar />

  <main class="pricing-page">

    <section class="section-hero">
      <div class="container container--narrow">
        <p class="eyebrow">{t(locale, 'prijzen.hero.eyebrow')}</p>
        <h1 class="hero-title">{t(locale, 'prijzen.hero.title')}</h1>
        <p class="hero-sub">{t(locale, 'prijzen.hero.sub')}</p>
        <p class="hero-note">{t(locale, 'prijzen.hero.note')}</p>
      </div>
    </section>

    <section class="section-cards">
      <div class="container container--plans">
        <div class="cards-grid">
          {plans.map((plan) => (
            <PricingCard
              image={plan.image}
              imageAlt={plan.imageAlt}
              title={plan.title}
              duration={plan.duration}
              price={plan.price}
              monthlyPrice={plan.monthlyPrice}
              description={plan.description}
              featured={plan.featured}
              startUrl={plan.startUrl}
            />
          ))}
        </div>
      </div>
    </section>

    <section class="section-trust" aria-label={t(locale, 'prijzen.trustLabel')}>
      <div class="container container--plans">
        <div class="trust-strip">
          {trustItems.map((item, i) => (
            <div class="trust-item">
              <span class="trust-item__icon" aria-hidden="true" set:html={trustIcons[i]} />
              {item}
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section-ext">
      <div class="container container--plans">
        <div class="ext-box">
          <div class="ext-left">
            <h2 class="ext-title">{t(locale, 'prijzen.extensions.title')}</h2>
            <p class="ext-sub" set:html={t(locale, 'prijzen.extensions.subHtml')} />
            <div class="ext-note">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              </svg>
              {t(locale, 'prijzen.extensions.note')}
            </div>
          </div>
          <div class="ext-right">
            {extensions.map((e, i) => (
              <div class:list={['ext-item', i === extensions.length - 1 && 'ext-item--highlight']}>
                <p class="ext-item__period">{e.period}</p>
                <p class="ext-item__price">{e.price}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section-feat">
      <div class="container container--plans">
        <h2 class="section-title">{t(locale, 'prijzen.features.title')}</h2>
        <div class="feat-grid">
          {features.map((f) => (
            <div class="feat-card">
              <span class="feat-card__icon" set:html={f.icon} />
              <h3 class="feat-card__title">{f.title}</h3>
              <p class="feat-card__desc">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <FaqAccordion title={t(locale, 'prijzen.faqs.title')} items={pricingFaqs} id="prijzen-faq" />

    <section class="section-ref">
      <div class="container container--plans">
        <div class="ref-box">
          <div class="ref-left">
            <div class="ref-badge">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>
              </svg>
              {t(locale, 'prijzen.referral.badge')}
            </div>
            <h2 class="ref-title">{t(locale, 'prijzen.referral.title')}</h2>
            <p class="ref-sub">{t(locale, 'prijzen.referral.sub')}</p>
            <a href={referralUrl} class="ref-btn" target="_blank" rel="noopener noreferrer">
              {t(locale, 'prijzen.referral.cta')}
            </a>
          </div>
          <img
            src="/referral-envelope.png"
            alt={t(locale, 'prijzen.referral.imageAlt')}
            class="ref-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </section>

  </main>

  <Footer />
</BaseLayout>

<style>
  .pricing-page {
    font-family: 'Nunito Sans', sans-serif;
    background: #F6F1E8;
    color: #4A4438;
  }

  .container {
    margin-inline: auto;
    padding-inline: 24px;
  }

  .container--narrow {
    max-width: 620px;
  }

  .container--plans {
    max-width: 1080px;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #B8934A;
    margin: 0 0 18px;
  }

  .section-hero {
    text-align: center;
    padding: 56px 0 0;
  }

  .hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2rem, 4.5vw, 46px);
    line-height: 1.14;
    color: #1C2A43;
    margin: 0 0 18px;
    text-wrap: pretty;
  }

  .hero-sub {
    font-size: 16.5px;
    line-height: 1.65;
    color: #7A7263;
    margin: 0 0 10px;
  }

  .hero-note {
    font-size: 14.5px;
    font-weight: 700;
    color: #4A4438;
    margin: 0;
  }

  .section-cards {
    padding-top: 48px;
  }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .section-trust {
    padding-top: 26px;
  }

  .trust-strip {
    display: flex;
    justify-content: center;
    gap: 28px;
    flex-wrap: wrap;
  }

  .trust-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 700;
    color: #5C5548;
  }

  .trust-item__icon {
    display: inline-flex;
    flex-shrink: 0;
  }

  .section-ext {
    padding-top: 64px;
  }

  .ext-box {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 20px;
    padding: 40px 44px;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 40px;
    align-items: center;
  }

  .ext-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 26px;
    line-height: 1.25;
    color: #1C2A43;
    margin: 0 0 12px;
  }

  .ext-sub {
    font-size: 14.5px;
    line-height: 1.7;
    color: #7A7263;
    margin: 0 0 12px;
  }

  .ext-sub :global(strong) {
    color: #4A4438;
    font-weight: 700;
  }

  .ext-note {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 700;
    color: #96742F;
  }

  .ext-right {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }

  .ext-item {
    border: 1px solid #EFE8DB;
    border-radius: 12px;
    padding: 14px 8px;
    text-align: center;
  }

  .ext-item--highlight {
    background: #F8F3E9;
  }

  .ext-item__period {
    font-size: 12px;
    font-weight: 700;
    color: #4A4438;
    margin: 0;
  }

  .ext-item__price {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 16px;
    font-weight: 600;
    color: #B8934A;
    margin: 6px 0 0;
  }

  .section-feat {
    padding-top: 80px;
  }

  .section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 34px);
    line-height: 1.15;
    color: #1C2A43;
    margin: 0 0 36px;
    text-align: center;
  }

  .feat-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }

  .feat-card {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 16px;
    padding: 26px 24px;
  }

  .feat-card__icon {
    display: inline-flex;
    width: 42px;
    height: 42px;
    border-radius: 11px;
    background: #F3E7CF;
    color: #96742F;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
  }

  .feat-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 17px;
    font-weight: 600;
    color: #1C2A43;
    margin: 0 0 7px;
  }

  .feat-card__desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: #7A7263;
    margin: 0;
  }

  .section-ref {
    padding: 80px 0 96px;
  }

  .ref-box {
    background: #F5EEE0;
    border: 10px solid #FFFDF8;
    border-radius: 28px;
    padding: 48px 52px;
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: 40px;
    align-items: center;
    box-shadow: 0 18px 40px -20px rgba(28, 42, 67, 0.18);
  }

  .ref-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #FDFBF7;
    border: 1px solid #EADFC9;
    color: #96742F;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 7px 16px;
    border-radius: 999px;
    margin-bottom: 18px;
  }

  .ref-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 32px);
    line-height: 1.2;
    color: #1C2A43;
    margin: 0 0 14px;
    text-wrap: pretty;
  }

  .ref-sub {
    font-size: 15.5px;
    line-height: 1.7;
    color: #7A7263;
    margin: 0 0 26px;
    max-width: 480px;
  }

  .ref-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1C2A43;
    color: #fff;
    font-size: 15px;
    font-weight: 700;
    padding: 14px 28px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .ref-btn:hover {
    background: #2A3B5C;
    color: #fff;
  }

  .ref-img {
    width: 100%;
    max-width: 300px;
    justify-self: center;
    display: block;
  }

  @media (max-width: 960px) {
    .cards-grid {
      grid-template-columns: 1fr;
      max-width: 420px;
      margin-inline: auto;
    }

    .ext-box {
      grid-template-columns: 1fr;
      padding: 32px 24px;
      gap: 28px;
    }

    .ext-right {
      grid-template-columns: repeat(3, 1fr);
    }

    .feat-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ref-box {
      grid-template-columns: 1fr;
      padding: 36px 28px;
      gap: 28px;
    }

    .ref-img {
      order: 2;
    }
  }

  @media (max-width: 540px) {
    .feat-grid {
      grid-template-columns: 1fr;
    }

    .ext-right {
      grid-template-columns: repeat(2, 1fr);
    }

    .ref-btn {
      white-space: normal;
      text-align: center;
      justify-content: center;
    }
  }
</style>
