---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLocale, t, tp, localizePath } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const afdelingOptions = tp<string[]>(locale, 'contact.form.afdelingOptions');
const faqUrl = localizePath(locale, '/prijzen') + '#prijzen-faq';
---

<BaseLayout title={t(locale, 'contact.meta.title')} description={t(locale, 'contact.meta.description')}>
  <Navbar />

  <main class="contact-page">
    <section class="contact">
      <div class="container contact__grid">

        <!-- Left column -->
        <div class="contact__left" data-reveal>
          <p class="eyebrow">{t(locale, 'contact.hero.eyebrow')}</p>
          <h1 class="contact__title">{t(locale, 'contact.hero.title')}</h1>
          <p class="contact__intro">{t(locale, 'contact.hero.sub')}</p>
          <p class="contact__reassure">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
            </svg>
            {t(locale, 'contact.hero.reassure')}
          </p>

          <div class="contact__cards">
            <a href="mailto:hello@remoria.eu" class="route-card route-card--email">
              <span class="route-card__icon route-card__icon--gold" aria-hidden="true">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>
                </svg>
              </span>
              <span>
                <span class="route-card__label">{t(locale, 'contact.info.emailLabel')}</span>
                <span class="route-card__title">hello@remoria.eu</span>
              </span>
            </a>

            <div class="route-card route-card--meet" id="plan-een-gesprek">
              <span class="route-card__icon route-card__icon--blue" aria-hidden="true">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/>
                </svg>
              </span>
              <span>
                <span class="route-card__label">{t(locale, 'contact.info.meetingLabel')}</span>
                <span class="route-card__title">{t(locale, 'contact.info.meetingTitle')}</span>
                <span class="route-card__sub">{t(locale, 'contact.info.meetingDesc')}</span>
                <button
                  type="button"
                  class="route-card__cta"
                  data-cal-link="remoria/30min"
                  data-cal-namespace="30min"
                  data-cal-config='{"layout":"month_view","useSlotsViewOnSmallScreen":"true"}'
                >
                  {t(locale, 'contact.info.meetingCta')}
                </button>
              </span>
            </div>

            <div class="faq-tip">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#96742F" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>
              </svg>
              <p class="faq-tip__text">
                {t(locale, 'contact.faqTip.before')}
                <a href={faqUrl}>{t(locale, 'contact.faqTip.link')}</a>{t(locale, 'contact.faqTip.after')}
              </p>
            </div>
          </div>
        </div>

        <!-- Right: form -->
        <div
          class="form-card"
          data-reveal
          data-reveal-delay="80"
          data-msg-sending={t(locale, 'contact.form.sending')}
          data-msg-error={t(locale, 'contact.form.error')}
          data-msg-required={t(locale, 'contact.form.validationRequired')}
          data-msg-email={t(locale, 'contact.form.validationEmail')}
        >
          <h2 class="form-card__title">{t(locale, 'contact.form.title')}</h2>
          <p class="form-card__sub">{t(locale, 'contact.form.sub')}</p>

          <form class="contact-form" id="contact-form" novalidate>
            <input
              type="text"
              name="website"
              class="form-honeypot"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />

            <div class="form-row form-row--2">
              <div class="form-field">
                <label class="form-label" for="naam">{t(locale, 'contact.form.naamLabel')}</label>
                <input
                  class="form-input"
                  type="text"
                  id="naam"
                  name="naam"
                  placeholder={t(locale, 'contact.form.naamPlaceholder')}
                  autocomplete="name"
                  required
                  maxlength="200"
                />
              </div>
              <div class="form-field">
                <label class="form-label" for="email">{t(locale, 'contact.form.emailLabel')}</label>
                <input
                  class="form-input"
                  type="email"
                  id="email"
                  name="email"
                  placeholder={t(locale, 'contact.form.emailPlaceholder')}
                  autocomplete="email"
                  required
                  maxlength="320"
                />
              </div>
            </div>

            <div class="form-field">
              <label class="form-label" for="afdeling">{t(locale, 'contact.form.afdelingLabel')}</label>
              <select class="form-input form-select" id="afdeling" name="afdeling">
                {afdelingOptions.map((option, i) => (
                  <option value={option} selected={i === 0}>{option}</option>
                ))}
              </select>
            </div>

            <div class="form-field">
              <label class="form-label" for="bericht">{t(locale, 'contact.form.berichtLabel')}</label>
              <textarea
                class="form-input form-textarea"
                id="bericht"
                name="bericht"
                placeholder={t(locale, 'contact.form.berichtPlaceholder')}
                rows="5"
                required
                maxlength="5000"
              ></textarea>
            </div>

            <div class="form-success" id="contact-form-success" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/>
              </svg>
              {t(locale, 'contact.form.success')}
            </div>

            <p class="form-error" id="contact-form-error" role="alert" hidden></p>

            <div class="form-actions">
              <button type="submit" class="form-submit" id="contact-form-submit">
                <span class="form-submit__label">{t(locale, 'contact.form.submit')}</span>
              </button>
              <span class="form-privacy">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                {t(locale, 'contact.form.privacy')}
              </span>
            </div>
          </form>
        </div>

      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  (function (C, A, L) { let p = function (a, ar) { a.q.push(ar); }; let d = C.document; C.Cal = C.Cal || function () { let cal = C.Cal; let ar = arguments; if (!cal.loaded) { cal.ns = {}; cal.q = cal.q || []; d.head.appendChild(d.createElement("script")).src = A; cal.loaded = true; } if (ar[0] === L) { const api = function () { p(api, arguments); }; const namespace = ar[1]; api.q = api.q || []; if(typeof namespace === "string"){cal.ns[namespace] = cal.ns[namespace] || api;p(cal.ns[namespace], ar);p(cal, ["initNamespace", namespace]);} else p(cal, ar); return;} p(cal, ar); }; })(window, "https://app.cal.eu/embed/embed.js", "init");
  Cal("init", "30min", {origin:"https://app.cal.eu"});
  Cal.config = Cal.config || {};
  Cal.config.forwardQueryParams = true;
  Cal.ns["30min"]("ui", {"hideEventTypeDetails":false,"layout":"month_view"});
</script>

<script>
  (function () {
    const elements = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const el = entry.target as HTMLElement;
            const delay = el.dataset.revealDelay ? parseInt(el.dataset.revealDelay) : 0;
            setTimeout(() => el.classList.add('is-visible'), delay);
            observer.unobserve(el);
          }
        });
      },
      { threshold: 0.12 }
    );
    elements.forEach((el) => observer.observe(el));
  })();
</script>

<script>
  (function () {
    const card = document.querySelector<HTMLElement>('.form-card');
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const successEl = document.getElementById('contact-form-success');
    const errorEl = document.getElementById('contact-form-error');
    const submitBtn = document.getElementById('contact-form-submit') as HTMLButtonElement | null;
    const submitLabel = submitBtn?.querySelector('.form-submit__label');
    const naamInput = document.getElementById('naam') as HTMLInputElement | null;
    const emailInput = document.getElementById('email') as HTMLInputElement | null;

    if (!card || !form || !successEl || !errorEl || !submitBtn || !submitLabel || !naamInput || !emailInput) return;

    const msgSending = card.dataset.msgSending || 'Sending…';
    const msgError = card.dataset.msgError || 'Something went wrong.';
    const msgRequired = card.dataset.msgRequired || 'Please fill in this field.';
    const msgEmail = card.dataset.msgEmail || 'Please enter a valid email.';
    const defaultLabel = submitLabel.textContent || '';

    const emailOk = (value: string) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);

    const setFieldInvalid = (el: HTMLElement, invalid: boolean) => {
      el.classList.toggle('is-invalid', invalid);
    };

    const validate = () => {
      let ok = true;
      const naam = naamInput.value.trim();
      const email = emailInput.value.trim();

      if (!naam) {
        setFieldInvalid(naamInput, true);
        naamInput.setCustomValidity(msgRequired);
        ok = false;
      } else {
        setFieldInvalid(naamInput, false);
        naamInput.setCustomValidity('');
      }

      if (!email) {
        setFieldInvalid(emailInput, true);
        emailInput.setCustomValidity(msgRequired);
        ok = false;
      } else if (!emailOk(email)) {
        setFieldInvalid(emailInput, true);
        emailInput.setCustomValidity(msgEmail);
        ok = false;
      } else {
        setFieldInvalid(emailInput, false);
        emailInput.setCustomValidity('');
      }

      return ok;
    };

    ['input', 'blur'].forEach((evt) => {
      naamInput.addEventListener(evt, () => {
        if (naamInput.value.trim()) {
          setFieldInvalid(naamInput, false);
          naamInput.setCustomValidity('');
        }
      });
      emailInput.addEventListener(evt, () => {
        const v = emailInput.value.trim();
        if (v && emailOk(v)) {
          setFieldInvalid(emailInput, false);
          emailInput.setCustomValidity('');
        }
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      successEl.hidden = true;
      errorEl.hidden = true;

      if (!validate()) {
        form.reportValidity();
        return;
      }

      const data = new FormData(form);
      const payload = {
        naam: String(data.get('naam') || '').trim(),
        email: String(data.get('email') || '').trim(),
        afdeling: String(data.get('afdeling') || '').trim(),
        bericht: String(data.get('bericht') || '').trim(),
        website: String(data.get('website') || '').trim(),
      };

      if (!payload.bericht) {
        form.reportValidity();
        return;
      }

      submitBtn.disabled = true;
      submitLabel.textContent = msgSending;

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(result.error || 'Request failed');

        form.reset();
        successEl.hidden = false;
      } catch {
        errorEl.hidden = false;
        errorEl.textContent = msgError;
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = defaultLabel;
      }
    });
  })();
</script>

<style>
  .contact-page {
    font-family: 'Nunito Sans', sans-serif;
    background: #F6F1E8;
    color: #4A4438;
  }

  .contact {
    background:
      linear-gradient(180deg, #F1E9D9, rgba(241, 233, 217, 0) 420px),
      url('/flowers-background.webp') left bottom / 560px auto no-repeat;
  }

  .container {
    max-width: 1140px;
    margin-inline: auto;
    padding: 64px 24px 96px;
  }

  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 64px;
    align-items: start;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #B8934A;
    margin: 0 0 18px;
  }

  .contact__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2rem, 4.5vw, 48px);
    line-height: 1.12;
    color: #1C2A43;
    margin: 0 0 18px;
    text-wrap: pretty;
  }

  .contact__intro {
    font-size: 16.5px;
    line-height: 1.65;
    color: #7A7263;
    margin: 0 0 12px;
    max-width: 420px;
  }

  .contact__reassure {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 13.5px;
    font-weight: 700;
    color: #96742F;
    margin: 0 0 34px;
  }

  .contact__cards {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 440px;
  }

  .route-card {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 16px;
    padding: 22px 24px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease;
  }

  .route-card--email:hover {
    box-shadow: 0 14px 30px -16px rgba(28, 42, 67, 0.22);
  }

  .route-card__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .route-card__icon--gold {
    background: #F3E7CF;
    color: #96742F;
  }

  .route-card__icon--blue {
    background: #E2E7EC;
    color: #4A6E8C;
  }

  .route-card__label {
    display: block;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #A79C87;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .route-card__title {
    display: block;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 19px;
    font-weight: 600;
    color: #1C2A43;
  }

  .route-card__sub {
    display: block;
    font-size: 13.5px;
    line-height: 1.55;
    color: #7A7263;
    margin-top: 4px;
  }

  .route-card--meet .route-card__sub {
    margin: 4px 0 14px;
  }

  .route-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1C2A43;
    color: #fff;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    padding: 11px 22px;
    border-radius: 999px;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.2s ease;
  }

  .route-card__cta:hover {
    background: #2A3B5C;
  }

  .faq-tip {
    border: 1px solid #E7DFC2;
    background: #F8F3E9;
    border-radius: 16px;
    padding: 18px 24px;
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .faq-tip__text {
    font-size: 13.5px;
    line-height: 1.6;
    color: #6B6353;
    margin: 0;
  }

  .faq-tip__text a {
    font-weight: 700;
    color: #96742F;
    text-decoration: none;
  }

  .faq-tip__text a:hover {
    text-decoration: underline;
  }

  .form-card {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 20px;
    padding: 40px 40px 36px;
    box-shadow: 0 22px 44px -24px rgba(28, 42, 67, 0.25);
  }

  .form-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    color: #1C2A43;
    margin: 0 0 4px;
  }

  .form-card__sub {
    font-size: 13.5px;
    color: #A79C87;
    margin: 0 0 26px;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
  }

  .form-honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .form-row--2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .form-field {
    margin-bottom: 16px;
  }

  .form-row--2 .form-field {
    margin-bottom: 0;
  }

  .form-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: #4A4438;
    margin-bottom: 6px;
  }

  .form-input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #E7DFD2;
    border-radius: 10px;
    background: #fff;
    padding: 12px 14px;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    color: #4A4438;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #C9A86B;
    box-shadow: 0 0 0 3px rgba(217, 179, 106, 0.2);
  }

  .form-input.is-invalid {
    border-color: #C47A6A;
  }

  .form-select {
    appearance: auto;
    cursor: pointer;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.6;
    margin-bottom: 6px;
  }

  .form-field:has(.form-textarea) {
    margin-bottom: 22px;
  }

  .form-success {
    display: flex;
    align-items: center;
    gap: 10px;
    background: #EAF0E4;
    border: 1px solid #CBDABD;
    border-radius: 12px;
    padding: 14px 18px;
    margin-bottom: 18px;
    font-size: 14px;
    font-weight: 700;
    color: #5C7048;
  }

  .form-success[hidden] {
    display: none !important;
  }

  .form-error {
    font-size: 13.5px;
    font-weight: 600;
    color: #9B3B2E;
    margin: 0 0 14px;
  }

  .form-error[hidden] {
    display: none !important;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .form-submit {
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #D9B36A;
    color: #1C2A43;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    font-weight: 800;
    padding: 14px 30px;
    border-radius: 999px;
    transition: background-color 0.2s ease;
  }

  .form-submit:hover {
    background: #E3C285;
  }

  .form-submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  .form-privacy {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    color: #A79C87;
  }

  [data-reveal] {
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 900px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .contact__cards {
      max-width: none;
    }

    .form-card {
      padding: 32px 24px;
    }
  }

  @media (max-width: 560px) {
    .container {
      padding: 48px 20px 72px;
    }

    .form-row--2 {
      grid-template-columns: 1fr;
    }

    .form-actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
