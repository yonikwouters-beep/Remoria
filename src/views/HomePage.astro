---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import Benefits from '../components/Benefits.astro';
import CTABanner from '../components/CTABanner.astro';
import Footer from '../components/Footer.astro';
import { getLocale, t } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);

const siteUrl = 'https://www.remoria.eu';
const pageUrl = new URL(Astro.url.pathname, siteUrl).href;
const inLanguage = { nl: 'nl-BE', en: 'en', fr: 'fr-BE' }[locale];

// Merkgegevens voor Google: sitenaam "Remoria", logo en organisatie. Geen reviews of beoordelingen.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'Remoria',
      url: `${siteUrl}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}/favicon+footer/favicon-512-creme-tegel.png`,
        width: 512,
        height: 512,
      },
      email: 'hello@remoria.eu',
      description: t(locale, 'meta.defaultDescription'),
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Remoria',
      alternateName: ['remoria.eu', 'www.remoria.eu'],
      url: `${siteUrl}/`,
      inLanguage,
      publisher: { '@id': `${siteUrl}/#organization` },
    },
    {
      '@type': 'WebApplication',
      name: 'Remoria',
      description: t(locale, 'meta.defaultDescription'),
      url: pageUrl,
      applicationCategory: 'LifestyleApplication',
      operatingSystem: 'Web',
      publisher: { '@id': `${siteUrl}/#organization` },
    },
  ],
};
---

<BaseLayout>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Navbar />
  <Hero />
  <Features />
  <Benefits />
  <CTABanner />
  <Footer />
</BaseLayout>
