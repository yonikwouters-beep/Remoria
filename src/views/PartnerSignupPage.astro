---
/**
 * Aanmeldformulier voor uitvaartondernemingen. Stuurt naar de app
 * (app.remoria.eu/api/partner-signup), die er een prospect in HQ van maakt,
 * Remoria mailt en de aanvrager een bevestiging stuurt.
 * Stijl volgt het contactformulier.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLocale, t, tp, localizePath } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const steps = tp<{ title: string; text: string }[]>(locale, 'partnerSignup.steps');
const errors = tp<Record<string, string>>(locale, 'partnerSignup.form.errors');
const meetUrl = localizePath(locale, '/contact#plan-een-gesprek');
const privacyUrl = localizePath(locale, '/privacy');
const f = (key: string) => t(locale, `partnerSignup.form.${key}`);
---

<BaseLayout title={t(locale, 'partnerSignup.meta.title')} description={t(locale, 'partnerSignup.meta.description')}>
  <Navbar />

  <main class="signup-page">
    <section class="signup">
      <div class="container signup__grid">
        <div class="signup__left">
          <p class="eyebrow">{t(locale, 'partnerSignup.eyebrow')}</p>
          <h1 class="signup__title">{t(locale, 'partnerSignup.title')}</h1>
          <p class="signup__intro">{t(locale, 'partnerSignup.intro')}</p>

          <h2 class="signup__steps-title">{t(locale, 'partnerSignup.stepsTitle')}</h2>
          <ol class="signup__steps">
            {steps.map((step, i) => (
              <li class="signup__step">
                <span class="signup__step-num" aria-hidden="true">{i + 1}</span>
                <span>
                  <strong>{step.title}</strong>
                  <span class="signup__step-text">{step.text}</span>
                </span>
              </li>
            ))}
          </ol>

          <p class="signup__meet">
            {t(locale, 'partnerSignup.meetBefore')}
            <a href={meetUrl}>{t(locale, 'partnerSignup.meetLink')}</a>
          </p>
        </div>

        <div class="form-card" id="partner-signup-card" data-lang={locale} data-sending={f('sending')} data-errors={JSON.stringify(errors)}>
          <div id="partner-signup-done" class="signup__done" hidden>
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 12 2 2 4-4"/><circle cx="12" cy="12" r="10"/>
            </svg>
            <h2 class="form-card__title">{f('successTitle')}</h2>
            <p class="signup__done-text">{f('successText')}</p>
          </div>

          <div id="partner-signup-body">
            <h2 class="form-card__title">{f('title')}</h2>
            <p class="form-card__sub">{f('sub')}</p>

            <form class="signup-form" id="partner-signup-form" novalidate>
              <input type="text" name="company_fax" class="form-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />

              <div class="form-field">
                <label class="form-label" for="ps-office">{f('officeLabel')}</label>
                <input class="form-input" type="text" id="ps-office" name="office_name" autocomplete="organization" required maxlength="160" />
              </div>

              <div class="form-row form-row--2">
                <div class="form-field">
                  <label class="form-label" for="ps-enterprise">{f('enterpriseLabel')}</label>
                  <input class="form-input" type="text" id="ps-enterprise" name="enterprise_number" placeholder={f('enterprisePlaceholder')} required maxlength="40" />
                </div>
                <div class="form-field">
                  <label class="form-label" for="ps-contact">{f('contactLabel')}</label>
                  <input class="form-input" type="text" id="ps-contact" name="contact_name" autocomplete="name" required maxlength="120" />
                </div>
              </div>

              <div class="form-row form-row--2">
                <div class="form-field">
                  <label class="form-label" for="ps-email">{f('emailLabel')}</label>
                  <input class="form-input" type="email" id="ps-email" name="email" placeholder={f('emailPlaceholder')} autocomplete="email" required maxlength="200" />
                </div>
                <div class="form-field">
                  <label class="form-label" for="ps-phone">{f('phoneLabel')}</label>
                  <input class="form-input" type="tel" id="ps-phone" name="phone" autocomplete="tel" required maxlength="40" />
                </div>
              </div>

              <div class="form-field">
                <label class="form-label" for="ps-street">{f('streetLabel')}</label>
                <input class="form-input" type="text" id="ps-street" name="street" autocomplete="street-address" maxlength="160" />
              </div>

              <div class="form-row form-row--3">
                <div class="form-field">
                  <label class="form-label" for="ps-postal">{f('postalLabel')}</label>
                  <input class="form-input" type="text" id="ps-postal" name="postal_code" autocomplete="postal-code" maxlength="12" />
                </div>
                <div class="form-field">
                  <label class="form-label" for="ps-city">{f('cityLabel')}</label>
                  <input class="form-input" type="text" id="ps-city" name="city" autocomplete="address-level2" maxlength="80" />
                </div>
                <div class="form-field">
                  <label class="form-label" for="ps-country">{f('countryLabel')}</label>
                  <select class="form-input form-select" id="ps-country" name="country">
                    {['BE', 'NL', 'LU'].map((c) => (
                      <option value={c} selected={c === 'BE'}>{f(`countries.${c}`)}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div class="form-field">
                <label class="form-label" for="ps-website">{f('websiteLabel')}</label>
                <input class="form-input" type="text" id="ps-website" name="website_url" placeholder={f('websitePlaceholder')} autocomplete="url" maxlength="200" />
              </div>

              <div class="form-field">
                <label class="form-label" for="ps-message">{f('messageLabel')}</label>
                <textarea class="form-input form-textarea" id="ps-message" name="message" rows="3" placeholder={f('messagePlaceholder')} maxlength="2000"></textarea>
              </div>

              <label class="form-consent">
                <input type="checkbox" id="ps-consent" name="accept_terms" required />
                <span>
                  {f('consentBefore')}<a href={privacyUrl} target="_blank" rel="noopener">{f('consentLink')}</a>{f('consentAfter')}
                </span>
              </label>

              <p class="form-error" id="partner-signup-error" role="alert" hidden></p>

              <div class="form-actions">
                <button type="submit" class="form-submit" id="partner-signup-submit">
                  <span class="form-submit__label">{f('submit')}</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<script>
  (function () {
    const API = 'https://app.remoria.eu/api/partner-signup';
    const card = document.getElementById('partner-signup-card');
    const form = document.getElementById('partner-signup-form') as HTMLFormElement | null;
    const errorEl = document.getElementById('partner-signup-error');
    const submitBtn = document.getElementById('partner-signup-submit') as HTMLButtonElement | null;
    const submitLabel = submitBtn?.querySelector('.form-submit__label');
    const body = document.getElementById('partner-signup-body');
    const done = document.getElementById('partner-signup-done');
    if (!card || !form || !errorEl || !submitBtn || !submitLabel || !body || !done) return;

    const errors: Record<string, string> = JSON.parse(card.dataset.errors || '{}');
    const lang = card.dataset.lang || 'nl';
    const sendingLabel = card.dataset.sending || '…';
    const defaultLabel = submitLabel.textContent || '';

    // Veld dat bij een foutcode van de server hoort, om het te markeren.
    const fieldFor: Record<string, string> = {
      invalid_office: 'ps-office',
      invalid_enterprise_number: 'ps-enterprise',
      invalid_name: 'ps-contact',
      invalid_email: 'ps-email',
      invalid_phone: 'ps-phone',
      terms_required: 'ps-consent',
    };

    const showError = (code: string) => {
      errorEl.textContent = errors[code] || errors.generic;
      errorEl.hidden = false;
      const id = fieldFor[code];
      const el = id ? document.getElementById(id) : null;
      if (el) {
        el.classList.add('is-invalid');
        el.focus();
      }
    };

    form.addEventListener('input', (e) => (e.target as HTMLElement).classList.remove('is-invalid'));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;

      // Eerst de verplichte velden in de browser controleren.
      const required = Array.from(form.querySelectorAll<HTMLInputElement>('[required]'));
      const missing = required.find((el) => (el.type === 'checkbox' ? !el.checked : !el.value.trim()));
      if (missing) {
        const code = Object.keys(fieldFor).find((k) => fieldFor[k] === missing.id);
        if (code === 'terms_required') showError(code);
        else {
          errorEl.textContent = errors.required;
          errorEl.hidden = false;
          missing.classList.add('is-invalid');
          missing.focus();
        }
        return;
      }

      const data = new FormData(form);
      const payload: Record<string, unknown> = { lang, accept_terms: data.get('accept_terms') === 'on' };
      for (const key of ['office_name', 'enterprise_number', 'contact_name', 'email', 'phone', 'street', 'postal_code', 'city', 'country', 'website_url', 'message', 'company_fax']) {
        payload[key] = String(data.get(key) || '').trim();
      }

      submitBtn.disabled = true;
      submitLabel.textContent = sendingLabel;
      try {
        const res = await fetch(API, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await res.json().catch(() => ({}));
        if (!res.ok) {
          showError(result.error || 'generic');
          return;
        }
        body.hidden = true;
        done.hidden = false;
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch {
        showError('generic');
      } finally {
        submitBtn.disabled = false;
        submitLabel.textContent = defaultLabel;
      }
    });
  })();
</script>

<style>
  .signup-page {
    font-family: 'Nunito Sans', sans-serif;
    background: #F6F1E8;
    color: #4A4438;
  }

  .signup {
    background:
      linear-gradient(180deg, #F1E9D9, rgba(241, 233, 217, 0) 420px),
      url('/flowers-background.webp') left bottom / 560px auto no-repeat;
  }

  .container {
    max-width: 1140px;
    margin-inline: auto;
    padding: 64px 24px 96px;
  }

  .signup__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 64px;
    align-items: start;
  }

  .eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #B8934A;
    margin: 0 0 18px;
  }

  .signup__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.9rem, 3.4vw, 42px);
    line-height: 1.12;
    color: #1C2A43;
    margin: 0 0 18px;
    text-wrap: balance;
    /* Nooit midden in een woord afbreken (de site breekt lange woorden standaard wel af). */
    overflow-wrap: normal;
    word-break: normal;
    hyphens: manual;
  }

  .signup__intro {
    font-size: 16.5px;
    line-height: 1.65;
    color: #7A7263;
    margin: 0 0 36px;
    max-width: 420px;
  }

  .signup__steps-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 20px;
    font-weight: 600;
    color: #1C2A43;
    margin: 0 0 18px;
  }

  .signup__steps {
    list-style: none;
    padding: 0;
    margin: 0 0 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 420px;
  }

  .signup__step {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.55;
    color: #1C2A43;
  }

  .signup__step-num {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: #F3E7CF;
    color: #96742F;
    font-weight: 800;
    font-size: 13.5px;
  }

  .signup__step-text {
    display: block;
    color: #7A7263;
  }

  .signup__meet {
    font-size: 14px;
    color: #6B6353;
  }

  .signup__meet a {
    font-weight: 700;
    color: #96742F;
    text-decoration: none;
  }

  .signup__meet a:hover {
    text-decoration: underline;
  }

  .form-card {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 20px;
    padding: 40px 40px 36px;
    box-shadow: 0 22px 44px -24px rgba(28, 42, 67, 0.25);
    scroll-margin-top: calc(var(--nav-height, 100px) + 16px);
  }

  .form-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 22px;
    font-weight: 600;
    color: #1C2A43;
    margin: 0 0 4px;
  }

  .form-card__sub {
    font-size: 13.5px;
    color: #A79C87;
    margin: 0 0 26px;
  }

  .signup__done {
    text-align: center;
    padding: 24px 0 12px;
    color: #5C7048;
  }

  .signup__done[hidden],
  #partner-signup-body[hidden] {
    display: none !important;
  }

  .signup__done .form-card__title {
    margin-top: 14px;
  }

  .signup__done-text {
    font-size: 15px;
    line-height: 1.65;
    color: #7A7263;
    max-width: 420px;
    margin: 10px auto 0;
  }

  .signup-form {
    display: flex;
    flex-direction: column;
  }

  .form-honeypot {
    position: absolute;
    left: -9999px;
    opacity: 0;
    pointer-events: none;
  }

  .form-row {
    display: grid;
    gap: 16px;
    margin-bottom: 16px;
    /* Velden op één lijn, ook als een label over twee regels loopt. */
    align-items: end;
  }

  .form-row--2 {
    grid-template-columns: 1fr 1fr;
  }

  .form-row--3 {
    grid-template-columns: 1fr 1.6fr 1.2fr;
  }

  .form-field {
    margin-bottom: 16px;
    min-width: 0;
  }

  .form-row .form-field {
    margin-bottom: 0;
  }

  .form-label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    color: #4A4438;
    margin-bottom: 6px;
  }

  .form-input {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid #E7DFD2;
    border-radius: 10px;
    background: #fff;
    padding: 12px 14px;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    color: #4A4438;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .form-input:focus {
    outline: none;
    border-color: #C9A86B;
    box-shadow: 0 0 0 3px rgba(217, 179, 106, 0.2);
  }

  .form-input.is-invalid,
  .form-consent input.is-invalid {
    border-color: #C47A6A;
    outline: 2px solid rgba(196, 122, 106, 0.35);
  }

  /* Invoervelden en keuzelijst even hoog, zodat een rij netjes op één lijn staat. */
  .form-input:not(.form-textarea) {
    height: 46px;
  }

  .form-select {
    appearance: auto;
    cursor: pointer;
  }

  .form-textarea {
    resize: vertical;
    min-height: 96px;
    line-height: 1.6;
  }

  .form-consent {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    font-size: 13px;
    line-height: 1.55;
    color: #6B6353;
    margin: 4px 0 20px;
    cursor: pointer;
  }

  .form-consent input {
    margin-top: 3px;
    width: 16px;
    height: 16px;
    accent-color: #B8934A;
    flex-shrink: 0;
  }

  .form-consent a {
    color: #96742F;
    font-weight: 700;
  }

  .form-error {
    font-size: 13.5px;
    font-weight: 600;
    color: #9B3B2E;
    margin: 0 0 14px;
  }

  .form-error[hidden] {
    display: none !important;
  }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  .form-submit {
    border: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #D9B36A;
    color: #1C2A43;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    font-weight: 800;
    padding: 14px 30px;
    border-radius: 999px;
    transition: background-color 0.2s ease;
  }

  .form-submit:hover {
    background: #E3C285;
  }

  .form-submit:disabled {
    opacity: 0.7;
    cursor: wait;
  }

  @media (max-width: 900px) {
    .signup__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .form-card {
      padding: 32px 24px;
    }
  }

  @media (max-width: 560px) {
    .container {
      padding: 48px 16px 72px;
    }

    .form-row--2,
    .form-row--3 {
      grid-template-columns: 1fr;
    }
  }
</style>
