---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/help.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { getLocale, localizePath, t } from '../i18n/utils';
import {
  articlePath,
  audienceRank,
  categoryFor,
  getHelpArticles,
  getHelpCategories,
  helpHomeAlternates,
  markdownToText,
  sortArticles,
} from '../help/content';

const locale = getLocale(Astro.currentLocale);
const articles = (await getHelpArticles(locale)).sort(sortArticles);
const categories = await getHelpCategories(locale);

// Artikels gegroepeerd per categorie, in de volgorde van categorieen.yml.
const groups = [...new Set(articles.map((entry) => entry.data.category))]
  .map((key) => ({
    category: categoryFor(categories, key),
    articles: articles.filter((entry) => entry.data.category === key),
  }))
  .sort((a, b) => a.category.order - b.category.order);

// Twee delen: eerst voor nabestaanden, dan voor uitvaartondernemers.
const audienceLabels = {
  nabestaanden: { title: t(locale, 'help.audienceNabestaanden'), intro: t(locale, 'help.audienceNabestaandenIntro') },
  partners: { title: t(locale, 'help.audiencePartners'), intro: t(locale, 'help.audiencePartnersIntro') },
} as const;
const sections = [...new Set(groups.map((group) => group.category.audience))]
  .sort((a, b) => audienceRank(a) - audienceRank(b))
  .map((audience) => ({
    audience,
    id: `voor-${audience}`,
    ...audienceLabels[audience],
    groups: groups.filter((group) => group.category.audience === audience),
  }));

// Kleine zoekindex, rechtstreeks in de pagina (geen externe dienst nodig).
const searchIndex = articles.map((entry) => ({
  title: entry.data.title,
  description: entry.data.description,
  category: `${audienceLabels[categoryFor(categories, entry.data.category).audience].title} · ${categoryFor(categories, entry.data.category).title}`,
  url: articlePath(entry),
  text: markdownToText(entry.body ?? ''),
}));

const alternates = helpHomeAlternates();
const countLabel = (n: number) =>
  n === 1 ? t(locale, 'help.articleCountOne') : t(locale, 'help.articleCountMany').replace('{n}', String(n));
---

<BaseLayout title={t(locale, 'help.metaTitle')} description={t(locale, 'help.metaDescription')} alternates={alternates}>
  <Navbar langHrefs={alternates} />

  <main class="help">
    <section class="help-hero">
      <div class="help-hero__inner">
        <p class="help-eyebrow">{t(locale, 'help.eyebrow')}</p>
        <h1 class="help-hero__title">{t(locale, 'help.title')}</h1>
        <p class="help-hero__intro">{t(locale, 'help.intro')}</p>

        <form class="help-search" role="search" data-help-search-form>
          <label for="help-search-input" class="help-visually-hidden">{t(locale, 'help.searchLabel')}</label>
          <svg class="help-search__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
          </svg>
          <input
            id="help-search-input"
            type="search"
            name="q"
            class="help-search__input"
            placeholder={t(locale, 'help.searchPlaceholder')}
            autocomplete="off"
            data-help-search
          />
          <button type="button" class="help-search__clear" aria-label={t(locale, 'help.searchClear')} data-help-search-clear hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
          </button>
        </form>
      </div>
    </section>

    <div class="help-body">
      <section
        class="help-results"
        aria-live="polite"
        data-help-results
        data-label-one={t(locale, 'help.resultsOne')}
        data-label-many={t(locale, 'help.resultsMany')}
        data-label-none={t(locale, 'help.noResults')}
        hidden
      >
        <p class="help-results__count" data-help-results-count></p>
        <ul class="help-cards" data-help-results-list></ul>
      </section>

      <div data-help-categories>
        {groups.length === 0 && <p class="help-empty">{t(locale, 'help.empty')}</p>}
        {sections.length > 1 && (
          <nav class="help-audience-nav" aria-label={t(locale, 'help.audienceNav')}>
            {sections.map((section) => (
              <a href={`#${section.id}`} class="help-audience-nav__link">{section.title}</a>
            ))}
          </nav>
        )}
        {sections.map((section) => (
          <section class="help-audience" id={section.id} aria-labelledby={`${section.id}-title`}>
            <header class="help-audience__header">
              <h2 class="help-audience__title" id={`${section.id}-title`}>{section.title}</h2>
              <p class="help-audience__intro">{section.intro}</p>
            </header>
            {section.groups.map((group) => (
              <section class="help-category" id={`categorie-${group.category.key}`}>
                <header class="help-category__header">
                  <h3 class="help-category__title">{group.category.title}</h3>
                  <span class="help-category__count">{countLabel(group.articles.length)}</span>
                </header>
                {group.category.description && <p class="help-category__desc">{group.category.description}</p>}
                <ul class="help-cards">
                  {group.articles.map((entry) => (
                    <li>
                      <a href={articlePath(entry)} class="help-card">
                        <span class="help-card__title">{entry.data.title}</span>
                        <span class="help-card__desc">{entry.data.description}</span>
                        <span class="help-card__arrow" aria-hidden="true">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </section>
        ))}
      </div>

      <aside class="help-contact">
        <div>
          <h2 class="help-contact__title">{t(locale, 'help.contactTitle')}</h2>
          <p class="help-contact__text">{t(locale, 'help.contactText')}</p>
        </div>
        <a href={localizePath(locale, '/contact')} class="help-contact__cta">{t(locale, 'help.contactCta')}</a>
      </aside>
    </div>

    <script type="application/json" id="help-search-index" set:html={JSON.stringify(searchIndex).replace(/</g, '\\u003c')} />
  </main>

  <Footer />
</BaseLayout>

<script>
  type Item = { title: string; description: string; category: string; url: string; text: string };

  const normalize = (value: string) =>
    value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')
      .replace(/[^a-z0-9]+/g, ' ')
      .trim();

  const indexEl = document.getElementById('help-search-index');
  const input = document.querySelector<HTMLInputElement>('[data-help-search]');
  const form = document.querySelector<HTMLFormElement>('[data-help-search-form]');
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-help-search-clear]');
  const results = document.querySelector<HTMLElement>('[data-help-results]');
  const resultsList = document.querySelector<HTMLElement>('[data-help-results-list]');
  const resultsCount = document.querySelector<HTMLElement>('[data-help-results-count]');
  const categoriesEl = document.querySelector<HTMLElement>('[data-help-categories]');

  if (indexEl && input && form && clearBtn && results && resultsList && resultsCount && categoriesEl) {
    const items = (JSON.parse(indexEl.textContent || '[]') as Item[]).map((item) => ({
      item,
      title: normalize(item.title),
      rest: normalize(`${item.description} ${item.category}`),
      text: normalize(item.text),
    }));

    const render = (query: string) => {
      const terms = normalize(query).split(' ').filter(Boolean);
      clearBtn.hidden = terms.length === 0;
      if (terms.length === 0) {
        results.hidden = true;
        categoriesEl.hidden = false;
        return;
      }

      const matches = items
        .map((entry) => {
          let score = 0;
          for (const term of terms) {
            if (entry.title.includes(term)) score += 10;
            else if (entry.rest.includes(term)) score += 4;
            else if (entry.text.includes(term)) score += 1;
            else return null; // elk zoekwoord moet ergens voorkomen
          }
          return { entry, score };
        })
        .filter((match): match is NonNullable<typeof match> => match !== null)
        .sort((a, b) => b.score - a.score);

      resultsList.replaceChildren(
        ...matches.map(({ entry }) => {
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.className = 'help-card';
          a.href = entry.item.url;
          const title = document.createElement('span');
          title.className = 'help-card__title';
          title.textContent = entry.item.title;
          const desc = document.createElement('span');
          desc.className = 'help-card__desc';
          desc.textContent = entry.item.description;
          const cat = document.createElement('span');
          cat.className = 'help-card__category';
          cat.textContent = entry.item.category;
          const arrow = document.createElement('span');
          arrow.className = 'help-card__arrow';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = '→';
          a.append(cat, title, desc, arrow);
          li.append(a);
          return li;
        }),
      );

      const n = matches.length;
      resultsCount.textContent =
        n === 0
          ? results.dataset.labelNone || ''
          : n === 1
            ? results.dataset.labelOne || ''
            : (results.dataset.labelMany || '').replace('{n}', String(n));
      results.hidden = false;
      categoriesEl.hidden = true;
    };

    input.addEventListener('input', () => render(input.value));
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      render(input.value);
    });
    clearBtn.addEventListener('click', () => {
      input.value = '';
      render('');
      input.focus();
    });

    // ?q=... vult de zoekopdracht in (handig om vanuit de app of de chat te linken).
    const initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      render(initial);
    }
  }
</script>
