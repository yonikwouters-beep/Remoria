---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import GuaranteeBadge from '../components/GuaranteeBadge.astro';
import { getLocale, t, tp, localizePath } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);

type HowStep = { title: string; text: string };
type FeatureCard = { title: string; sub: string };
type PhotobookStep = { title: string; text: string };
type TrustItem = { title: string; text: string };
type FaqItem = { question: string; answer: string };

const howSteps = tp<HowStep[]>(locale, 'nabestaanden.how.steps');
const featureCards = tp<FeatureCard[]>(locale, 'nabestaanden.features.cards');
const photobookSteps = tp<PhotobookStep[]>(locale, 'nabestaanden.features.photobook.steps');
const trustItems = tp<TrustItem[]>(locale, 'nabestaanden.trust');
const nabestaandenFaqs = tp<FaqItem[]>(locale, 'nabestaanden.faqs.items');

const howIcons = [
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" y1="8" x2="19" y2="14"/><line x1="22" y1="11" x2="16" y2="11"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>`,
  `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
];

const featureCardIcons = [
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
];

/** Optional screenshots for feature cards (Mediacollectie, Community chat, Eerbetonen) */
const featureCardImages: (string | null)[] = [
  '/mediacollectie-preview.png',
  '/community-chat-preview.png',
  '/eerbetonen-preview.png',
];

const photobookStepIcons = [
  `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>`,
  `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>`,
  `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12V22H4V12"/><path d="M22 7H2v5h20V7z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>`,
];

const trustIcons = [
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>`,
  `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
];

const prijzenUrl = localizePath(locale, '/prijzen');
---

<BaseLayout title={t(locale, 'nabestaanden.meta.title')} description={t(locale, 'nabestaanden.meta.description')}>
  <Navbar />

  <!-- ══════════════════════════════════════════════
       1. HERO
  ══════════════════════════════════════════════ -->
  <section class="hero" aria-labelledby="hero-heading" data-reveal>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container">
      <div class="hero__content" data-reveal>
        <p class="eyebrow">{t(locale, 'nabestaanden.hero.eyebrow')}</p>
        <h1 class="hero__title" id="hero-heading">
          {t(locale, 'nabestaanden.hero.titleLine1')}<br />{t(locale, 'nabestaanden.hero.titleLine2')}<br />{t(locale, 'nabestaanden.hero.titleLine3')}
        </h1>
        <p class="hero__body">
          {t(locale, 'nabestaanden.hero.body')}
        </p>
        <div class="hero__actions">
          <a href={prijzenUrl} class="btn btn--primary">
            {t(locale, 'nabestaanden.hero.ctaPrimary')}
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="https://remoria.eu/demo"
            class="btn btn--ghost"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="btn__play" aria-hidden="true">
              <svg width="9" height="11" viewBox="0 0 9 11" fill="currentColor">
                <path d="M0 0l9 5.5L0 11V0z"/>
              </svg>
            </span>
            {t(locale, 'nabestaanden.hero.ctaSecondary')}
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       2. HOW IT WORKS
  ══════════════════════════════════════════════ -->
  <section class="how" id="hoe-werkt-het">
    <div class="container">

      <div class="how__header" data-reveal>
        <div class="how__divider" aria-hidden="true"></div>
        <p class="eyebrow eyebrow--center">{t(locale, 'nabestaanden.how.eyebrow')}</p>
        <h2 class="section-title">{t(locale, 'nabestaanden.how.title').split('\n').map((line, i, arr) => i < arr.length - 1 ? [line, <br />] : line)}</h2>
        <p class="section-sub">{t(locale, 'nabestaanden.how.sub')}</p>
      </div>

      <div class="how__cards">
        {howSteps.map((step, i) => (
          <div class="how-card" data-reveal data-reveal-delay={String(i * 80)}>
            <div class="how-card__top">
              <div class="how-card__icon" aria-hidden="true" set:html={howIcons[i]} />
              <span class="how-card__step">{i + 1}</span>
            </div>
            <h3 class="how-card__title">{step.title}</h3>
            <p class="how-card__text">{step.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       3. FEATURES GRID
  ══════════════════════════════════════════════ -->
  <section class="fg">
    <div class="container">

      <!-- Header -->
      <div class="fg__header" data-reveal>
        <p class="eyebrow eyebrow--center">
          <span class="eyebrow__plus" aria-hidden="true">+</span> {t(locale, 'nabestaanden.features.eyebrow')}
        </p>
        <h2 class="section-title fg__title">
          {t(locale, 'nabestaanden.features.title')}
        </h2>
        <p class="section-sub fg__sub">
          {t(locale, 'nabestaanden.features.sub')}
        </p>
      </div>

      <!-- Three top cards -->
      <div class="fg__top">
        {featureCards.map((card, i) => (
          <div class="fg-card" data-reveal data-reveal-delay={String(i * 80)}>
            <div class="fg-card__head">
              <div class="fg-card__icon" aria-hidden="true" set:html={featureCardIcons[i]} />
              <div>
                <h3 class="fg-card__title">{card.title}</h3>
                <p class="fg-card__sub">{card.sub}</p>
              </div>
            </div>
            {featureCardImages[i] ? (
              <div class="fg-card__screen fg-card__screen--media">
                <img
                  src={featureCardImages[i]!}
                  alt={card.title}
                  class="fg-card__screen-img"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            ) : (
              <div class="fg-card__screen" aria-label={`Screenshot placeholder ${card.title}`}></div>
            )}
          </div>
        ))}
      </div>

      <!-- Wide photobook card -->
      <div class="fg-wide" id="fotoboek" data-reveal>
        <div class="fg-wide__left">
          <div class="fg-wide__head">
            <div class="fg-card__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </div>
            <div>
              <h3 class="fg-card__title">{t(locale, 'nabestaanden.features.photobook.title')}</h3>
              <p class="fg-card__sub">{t(locale, 'nabestaanden.features.photobook.sub')}</p>
            </div>
          </div>

          <ul class="fg-steps">
            {photobookSteps.map((step, i) => (
              <li class="fg-step">
                <div class="fg-step__icon" aria-hidden="true" set:html={photobookStepIcons[i]} />
                <div>
                  <p class="fg-step__title">{step.title}</p>
                  <p class="fg-step__text">{step.text}</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="fg-wide__screen fg-wide__screen--media">
          <img
            src="/fotoboek-preview.png"
            alt={t(locale, 'nabestaanden.features.photobook.title')}
            class="fg-wide__screen-img"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      <!-- Trust footer -->
      <div class="fg__trust" data-reveal>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <span>{t(locale, 'nabestaanden.features.trustPrivacy')}</span>
        <span class="fg__trust-dot" aria-hidden="true">•</span>
        <span>{t(locale, 'nabestaanden.features.trustAccess')}</span>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       4. QUOTE BANNER
  ══════════════════════════════════════════════ -->
  <section class="quote-banner">
    <div class="container">
      <div class="quote-banner__inner" data-reveal>
        <div class="quote-banner__overlay"></div>
        <div class="quote-banner__content">
          <span class="quote-banner__mark" aria-hidden="true">"</span>
          <blockquote class="quote-banner__quote">
            {t(locale, 'nabestaanden.quoteLine1')}<br />{t(locale, 'nabestaanden.quoteLine2')}
          </blockquote>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       5. FINAL CTA
  ══════════════════════════════════════════════ -->
  <section class="cta" data-reveal>
    <div class="container">
      <div class="cta__inner">
        <h2 class="cta__title">{t(locale, 'nabestaanden.cta.titleLine1')}<br />{t(locale, 'nabestaanden.cta.titleLine2')}</h2>
        <p class="cta__sub">
          {t(locale, 'nabestaanden.cta.sub')}
        </p>
        <a href={prijzenUrl} class="btn btn--primary btn--lg">
          {t(locale, 'nabestaanden.cta.button')}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <div class="cta__guarantee">
          <GuaranteeBadge />
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       6. TRUST BAR
  ══════════════════════════════════════════════ -->
  <section class="trust" data-reveal>
    <div class="container">
      <div class="trust__grid">
        {trustItems.map((item, i) => (
          <div class="trust-item">
            <div class="trust-item__icon" aria-hidden="true" set:html={trustIcons[i]} />
            <h4 class="trust-item__title">{item.title}</h4>
            <p class="trust-item__text">{item.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FaqAccordion title={t(locale, 'nabestaanden.faqs.title')} items={nabestaandenFaqs} id="nabestaanden-faq" />

  <Footer />
</BaseLayout>

<!-- ═══════════════════════════════════════════════════════════
     SCROLL REVEAL
═══════════════════════════════════════════════════════════ -->
<script>
  (function () {
    const els = document.querySelectorAll('[data-reveal]');
    if (!els.length) return;

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const delay = (e.target as HTMLElement).dataset.revealDelay || '0';
            setTimeout(() => e.target.classList.add('is-visible'), Number(delay));
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.12 }
    );

    els.forEach((el) => io.observe(el));
  })();
</script>

<style>
  /* ─── Tokens ──────────────────────────────────── */
  :root {
    --bg:        #F7F4EE;
    --ink:       #1E293B;
    --muted:     #6B7280;
    --gold:      #C6A24B;
    --gold-soft: rgba(198, 162, 75, 0.12);
    --card-bg:   rgba(255, 255, 255, 0.72);
    --radius-img: 28px;
    --radius-card: 20px;
  }

  /* ─── Base ─────────────────────────────────────── */
  section {
    background-color: var(--bg);
  }

  .container {
    max-width: 1160px;
    margin: 0 auto;
    padding-inline: clamp(20px, 5vw, 56px);
  }

  /* ─── Reveal ───────────────────────────────────── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.72s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  /* ─── Typography ────────────────────────────────── */
  .eyebrow {
    display: inline-block;
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 18px;
  }
  .eyebrow--center { display: block; text-align: center; }

  .section-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.9rem, 3.2vw, 2.85rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 16px;
  }

  .section-sub {
    font-family: 'Inter', sans-serif;
    font-size: clamp(15px, 1.4vw, 16px);
    line-height: 1.75;
    color: var(--muted);
  }

  /* ─── Buttons ───────────────────────────────────── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 28px;
    border-radius: 999px;
    font-family: 'Inter', sans-serif;
    font-size: 15px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    cursor: pointer;
    border: none;
  }
  .btn:hover { transform: translateY(-2px); }

  .btn--primary {
    background: var(--ink);
    color: #fff;
    box-shadow: 0 4px 20px rgba(30, 41, 59, 0.2);
  }
  .btn--primary:hover {
    background: #0f172a;
    box-shadow: 0 8px 28px rgba(30, 41, 59, 0.28);
  }

  .btn--ghost {
    background: #fff;
    color: var(--ink);
    border: 1px solid rgba(30, 41, 59, 0.14);
    box-shadow: 0 1px 4px rgba(30, 41, 59, 0.06);
  }
  .btn--ghost:hover {
    border-color: rgba(30, 41, 59, 0.24);
    box-shadow: 0 4px 16px rgba(30, 41, 59, 0.1);
  }

  .btn--lg { padding: 16px 36px; font-size: 16px; }

  .btn__play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: var(--ink);
    color: #fff;
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* ════════════════════════════════════════════
     HERO
  ════════════════════════════════════════════ */
  .hero {
    position: relative;
    background-color: var(--bg);
    background-image: url('/Voor-nabestaanden-web.webp');
    background-size: cover;
    background-position: 66% 18%;
    background-repeat: no-repeat;
    min-height: clamp(520px, 64vw, 740px);
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      #F7F4EE 0%,
      rgba(247, 244, 238, 0.97) 26%,
      rgba(247, 244, 238, 0.82) 44%,
      rgba(247, 244, 238, 0.45) 62%,
      rgba(247, 244, 238, 0.08) 82%,
      rgba(247, 244, 238, 0) 100%
    );
  }

  .hero .container {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-block: clamp(64px, 9vw, 104px);
  }

  .hero__content {
    max-width: 520px;
  }

  .hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(2.2rem, 4.2vw, 3.8rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin-bottom: 24px;
  }

  .hero__body {
    font-family: 'Inter', sans-serif;
    font-size: clamp(15px, 1.5vw, 16px);
    line-height: 1.8;
    color: var(--muted);
    max-width: 460px;
    margin-bottom: 40px;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ════════════════════════════════════════════
     HOW IT WORKS
  ════════════════════════════════════════════ */
  .how {
    padding: clamp(72px, 10vh, 112px) 0;
    scroll-margin-top: 24px;
  }

  .how__header {
    text-align: center;
    max-width: 540px;
    margin: 0 auto clamp(52px, 7vh, 80px);
  }

  .how__divider {
    width: 36px;
    height: 2px;
    background: var(--gold);
    margin: 0 auto 20px;
    border-radius: 2px;
  }

  .how__cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 2.5vw, 32px);
  }

  .how-card {
    background: var(--card-bg);
    border: 1px solid rgba(30, 41, 59, 0.07);
    border-radius: var(--radius-card);
    padding: clamp(28px, 3.5vw, 44px) clamp(24px, 3vw, 38px);
    box-shadow:
      0 1px 3px rgba(30, 41, 59, 0.05),
      0 12px 32px rgba(30, 41, 59, 0.07);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .how-card:hover {
    transform: translateY(-4px);
    box-shadow:
      0 4px 8px rgba(30, 41, 59, 0.06),
      0 20px 48px rgba(30, 41, 59, 0.11);
  }

  .how-card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 24px;
  }

  .how-card__icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gold-soft);
    border-radius: 14px;
    color: var(--gold);
  }

  .how-card__step {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 2.2rem;
    font-weight: 500;
    color: rgba(198, 162, 75, 0.18);
    line-height: 1;
