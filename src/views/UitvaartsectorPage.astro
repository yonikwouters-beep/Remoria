---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import PartnerDashboardMockup from '../components/PartnerDashboardMockup.astro';
import { getLocale, t, tp, localizePath } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);

type Step = { title: string; desc: string };
type Card = { title: string; desc: string };

const heroChecks = tp<string[]>(locale, 'uitvaartsector.hero.checks');
const howSteps = tp<Step[]>(locale, 'uitvaartsector.how.steps');
const dashboardChecks = tp<string[]>(locale, 'uitvaartsector.dashboard.checks');
const partnerCards = tp<Card[]>(locale, 'uitvaartsector.partner.cards');
const familyCards = tp<Card[]>(locale, 'uitvaartsector.familyOffer.cards');

const contactUrl = localizePath(locale, '/contact');
const contactMeetUrl = localizePath(locale, '/contact#plan-een-gesprek');

const partnerCardIcons = [
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  `<span class="partner-card__euro" aria-hidden="true">&euro;</span>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>`,
];

const familyCardIcons = [
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
];

const familyCardTints = ['beige', 'sage', 'rose'] as const;
---

<BaseLayout title={t(locale, 'uitvaartsector.meta.title')} description={t(locale, 'uitvaartsector.meta.description')}>
  <Navbar />

  <!-- ══════════════════════════════════════════════
       1. HERO
  ══════════════════════════════════════════════ -->
  <section class="hero">
    <div class="container hero__grid">

      <div class="hero__content" data-reveal>
        <p class="eyebrow">{t(locale, 'uitvaartsector.hero.eyebrow')}</p>
        <h1 class="hero__title">{t(locale, 'uitvaartsector.hero.title')}</h1>
        <p class="hero__body">{t(locale, 'uitvaartsector.hero.body')}</p>

        <div class="hero__actions">
          <a href={contactUrl} class="btn btn--gold">
            {t(locale, 'uitvaartsector.hero.ctaPrimary')}
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href={contactMeetUrl} class="btn btn--white">
            <span class="btn__cal" aria-hidden="true">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2"/>
                <path d="M16 2v4M8 2v4M3 10h18"/>
              </svg>
            </span>
            {t(locale, 'uitvaartsector.hero.ctaSecondary')}
          </a>
        </div>

        <div class="hero__checks">
          {heroChecks.map((item) => (
            <div class="hero__check">
              <span class="hero__check-mark" aria-hidden="true">&#10003;</span>{item}
            </div>
          ))}
        </div>
      </div>

      <div class="hero__visual" data-reveal data-reveal-delay="100">
        <img
          src="/Uitvaartsector-remoria.webp"
          alt={t(locale, 'uitvaartsector.hero.imageAlt')}
          class="hero__img"
          loading="eager"
          decoding="async"
        />
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       2. ZO WERKT HET
  ══════════════════════════════════════════════ -->
  <section class="how">
    <div class="container">
      <div class="how__header" data-reveal>
        <p class="eyebrow eyebrow--center">{t(locale, 'uitvaartsector.how.eyebrow')}</p>
        <h2 class="how__title">{t(locale, 'uitvaartsector.how.title')}</h2>
      </div>

      <div class="how__grid">
        {howSteps.map((step, i) => (
          <div class="how-card" data-reveal data-reveal-delay={String(i * 80)}>
            <div class="how-card__top">
              <span class="how-card__num">{i + 1}</span>
              {i < howSteps.length - 1 && <span class="how-card__line" aria-hidden="true"></span>}
            </div>
            <h3 class="how-card__title">{step.title}</h3>
            <p class="how-card__desc">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       3. DASHBOARD
  ══════════════════════════════════════════════ -->
  <section class="dashboard">
    <div class="container dashboard__grid">

      <div class="dashboard__content" data-reveal>
        <div class="dashboard__chip">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/>
            <rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>
          </svg>
          {t(locale, 'uitvaartsector.dashboard.chip')}
        </div>
        <h3 class="dashboard__title">{t(locale, 'uitvaartsector.dashboard.title')}</h3>
        <p class="dashboard__body">{t(locale, 'uitvaartsector.dashboard.body')}</p>
        <div class="dashboard__checks">
          {dashboardChecks.map((item) => (
            <div class="dashboard__check">
              <span class="dashboard__check-mark" aria-hidden="true">&#10003;</span>{item}
            </div>
          ))}
        </div>
      </div>

      <div class="dashboard__visual" data-reveal data-reveal-delay="100">
        <div class="dashboard__mock-fit">
          <PartnerDashboardMockup variant="full" />
        </div>
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       4. PARTNERMODEL
  ══════════════════════════════════════════════ -->
  <section class="partner">
    <div class="container">
      <div class="partner__header" data-reveal>
        <p class="eyebrow eyebrow--center">{t(locale, 'uitvaartsector.partner.eyebrow')}</p>
        <h2 class="partner__title">{t(locale, 'uitvaartsector.partner.title')}</h2>
        <p class="partner__sub">{t(locale, 'uitvaartsector.partner.sub')}</p>
      </div>

      <div class="partner__grid">
        {partnerCards.map((card, i) => (
          <div class="partner-card" data-reveal data-reveal-delay={String(i * 80)}>
            <span class="partner-card__icon" aria-hidden="true" set:html={partnerCardIcons[i]} />
            <h3 class="partner-card__title">{card.title}</h3>
            <p class="partner-card__desc">{card.desc}</p>
          </div>
        ))}
      </div>

      <p class="partner__link" data-reveal>
        {t(locale, 'uitvaartsector.partner.linkBefore')}
        <a href={contactMeetUrl}>{t(locale, 'uitvaartsector.partner.linkCta')}</a>
      </p>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       5. WAT DE FAMILIE KRIJGT
  ══════════════════════════════════════════════ -->
  <section class="family">
    <div class="container">
      <div class="family__header" data-reveal>
        <p class="eyebrow eyebrow--center">{t(locale, 'uitvaartsector.familyOffer.eyebrow')}</p>
        <h2 class="family__title">{t(locale, 'uitvaartsector.familyOffer.title')}</h2>
      </div>

      <div class="family__grid">
        {familyCards.map((card, i) => (
          <div class:list={['family-card', `family-card--${familyCardTints[i]}`]} data-reveal data-reveal-delay={String(i * 80)}>
            <span class="family-card__icon" aria-hidden="true" set:html={familyCardIcons[i]} />
            <h3 class="family-card__title">{card.title}</h3>
            <p class="family-card__desc">{card.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════
       6. CTA BANNER
  ══════════════════════════════════════════════ -->
  <section class="cta-banner">
    <div class="container">
      <div class="cta-banner__card">
        <div class="cta-banner__overlay" aria-hidden="true"></div>
        <div class="cta-banner__inner" data-reveal>
          <blockquote class="cta-banner__quote">
            {t(locale, 'uitvaartsector.ctaBanner.quote')}
          </blockquote>
          <div class="cta-banner__cta-block">
            <div class="cta-banner__actions">
              <a href={contactUrl} class="btn btn--gold">
                {t(locale, 'uitvaartsector.ctaBanner.ctaPrimary')}
                <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <a href={contactUrl} class="btn btn--outline-light">
                {t(locale, 'uitvaartsector.ctaBanner.ctaSecondary')}
              </a>
            </div>
            <p class="cta-banner__legal">
              <a
                href="/Remoria-Verwerkersovereenkomst-Bijlage-AV.pdf"
                target="_blank"
                rel="noopener noreferrer"
              >{t(locale, 'uitvaartsector.ctaBanner.legal')}</a>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  (function () {
    const els = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (!els.length) return;

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement;
            const delay = el.dataset.revealDelay ? parseInt(el.dataset.revealDelay) : 0;
            setTimeout(() => el.classList.add('is-visible'), delay);
            obs.unobserve(el);
          }
        });
      },
      { threshold: 0.1 }
    );
    els.forEach((el) => obs.observe(el));
  })();
</script>

<style>
  /* ─────────────────────────────────────────────
     TOKENS
  ───────────────────────────────────────────── */
  :root {
    --uv-bg:      #F6F1E8;
    --uv-navy:    #1C2A43;
    --uv-gold:    #B8934A;
    --uv-gold-lt: #D9B36A;
    --uv-muted:   #7A7263;
    --uv-line:    #E7DFD2;
    --uv-card:    #FDFBF7;
  }

  /* ─────────────────────────────────────────────
     SHARED
  ───────────────────────────────────────────── */
  section {
    background-color: var(--uv-bg);
  }

  .container {
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 24px);
  }

  .eyebrow {
    display: block;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    color: var(--uv-gold);
    margin-bottom: 18px;
  }

  .eyebrow--center {
    text-align: center;
  }

  /* ── Scroll reveal ── */
  [data-reveal] {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }

  /* ── Buttons ── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    font-weight: 800;
    padding: 15px 30px;
    border-radius: 999px;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: transform 0.18s ease, box-shadow 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .btn--gold {
    background: var(--uv-gold-lt);
    color: var(--uv-navy);
    box-shadow: 0 4px 18px rgba(184, 147, 74, 0.28);
  }
  .btn--gold:hover {
    background: #e3c285;
    transform: translateY(-2px);
    box-shadow: 0 8px 26px rgba(184, 147, 74, 0.38);
  }

  .btn--white {
    background: #fff;
    color: var(--uv-navy);
    font-weight: 700;
    padding: 15px 26px 15px 12px;
    border: 1px solid var(--uv-line);
  }
  .btn--white:hover {
    border-color: var(--uv-navy);
    transform: translateY(-2px);
  }

  .btn--outline-light {
    background: transparent;
    color: #fff;
    font-weight: 700;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
  }
  .btn--outline-light:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-2px);
  }

  .btn__cal {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    background: var(--uv-navy);
    border-radius: 50%;
    color: #fff;
    flex-shrink: 0;
  }

  /* ─────────────────────────────────────────────
     1. HERO
  ───────────────────────────────────────────── */
  .hero {
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: 6fr 5fr;
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
    padding-block: clamp(56px, 9vw, 88px) clamp(48px, 8vw, 72px);
  }

  .hero__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2.1rem, 3.6vw, 3rem);
    line-height: 1.12;
    color: var(--uv-navy);
    margin: 0 0 22px;
    text-wrap: pretty;
  }

  .hero__body {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 17px;
    line-height: 1.65;
    color: var(--uv-muted);
    margin: 0 0 32px;
    max-width: 480px;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .hero__checks {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 32px;
  }

  .hero__check {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--uv-muted);
  }

  .hero__check-mark {
    color: var(--uv-gold);
    font-weight: 800;
  }

  .hero__visual {
    justify-self: end;
    width: 100%;
    max-width: 440px;
  }

  .hero__img {
    width: 100%;
    aspect-ratio: 4 / 4.6;
    object-fit: cover;
    display: block;
    border-radius: 220px 220px 20px 20px;
    box-shadow: 0 24px 50px -24px rgba(28, 42, 67, 0.35);
  }

  /* ─────────────────────────────────────────────
     2. ZO WERKT HET
  ───────────────────────────────────────────── */
  .how {
    background: #EFE6D5;
    padding-block: clamp(56px, 9vw, 88px);
  }

  .how__header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto clamp(40px, 6vw, 56px);
  }

  .how__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    color: var(--uv-navy);
    margin: 0;
  }

  .how__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .how-card {
    background: var(--uv-card);
    border: 1px solid var(--uv-line);
    border-radius: 16px;
    padding: 28px 26px;
  }

  .how-card__top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
  }

  .how-card__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--uv-navy);
    color: #fff;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    font-weight: 800;
  }

  .how-card__line {
    flex: 1;
    height: 1px;
    background: #E7DFC2;
  }

  .how-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 17px;
    color: var(--uv-navy);
    margin: 0 0 8px;
    line-height: 1.3;
  }

  .how-card__desc {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--uv-muted);
    margin: 0;
  }

  /* ─────────────────────────────────────────────
     3. DASHBOARD
  ───────────────────────────────────────────── */
  .dashboard {
    padding-block: clamp(64px, 9vw, 96px) 0;
  }

  .dashboard__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    align-items: center;
    gap: clamp(32px, 5vw, 64px);
    padding-bottom: clamp(64px, 9vw, 96px);
    min-width: 0;
  }

  .dashboard__content {
    min-width: 0;
    max-width: 100%;
  }

  .dashboard__chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #E2E7EC;
    color: #4A6E8C;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    padding: 7px 14px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .dashboard__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.5rem, 2.6vw, 1.875rem);
    line-height: 1.2;
    color: var(--uv-navy);
    margin: 0 0 16px;
    text-wrap: pretty;
    overflow-wrap: break-word;
  }

  .dashboard__body {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: var(--uv-muted);
    margin: 0 0 22px;
    overflow-wrap: break-word;
  }

  .dashboard__checks {
    display: flex;
    flex-direction: column;
    gap: 11px;
  }

  .dashboard__check {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    font-weight: 600;
    color: #4A4438;
  }

  .dashboard__check-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--uv-gold);
    color: #fff;
    font-size: 11px;
    font-weight: 800;
  }

  .dashboard__visual {
    background: #E2E7EC;
    border-radius: 20px;
    padding: clamp(14px, 3.5vw, 28px);
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    container-type: inline-size;
    container-name: dash-visual;
  }

  .dashboard__mock-fit {
    --dash-w: 720;
    --dash-zoom: 1;
    width: 100%;
    overflow: hidden;
  }

  /* Approximate fit when container query units aren't available */
  @media (max-width: 900px) {
    .dashboard__mock-fit {
      --dash-zoom: 0.62;
    }
  }
  @media (max-width: 640px) {
    .dashboard__mock-fit {
      --dash-zoom: 0.48;
    }
  }
  @media (max-width: 420px) {
    .dashboard__mock-fit {
      --dash-zoom: 0.4;
    }
  }

  @supports (width: 1cqi) {
    .dashboard__mock-fit {
      --dash-zoom: min(1, calc(100cqi / (var(--dash-w) * 1px)));
    }
  }

  .dashboard__mock-fit :global(.dash--full) {
    width: max-content;
    max-width: none;
    box-sizing: border-box;
  }

  /* Firefox: no zoom — scale with transform and reserve height */
  @supports not (zoom: 1) {
    .dashboard__mock-fit {
      --dash-h: 440;
      aspect-ratio: var(--dash-w) / var(--dash-h);
      position: relative;
    }

    .dashboard__mock-fit :global(.dash--full) {
      position: absolute;
      top: 0;
      left: 0;
      transform-origin: top left;
      transform: scale(min(1, calc(100cqi / (var(--dash-w) * 1px))));
    }
  }

  /* ─────────────────────────────────────────────
     4. PARTNERMODEL
  ───────────────────────────────────────────── */
  .partner {
    padding-block: clamp(64px, 9vw, 96px) 0;
  }

  .partner__header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto clamp(32px, 5vw, 48px);
  }

  .partner__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    color: var(--uv-navy);
    margin: 0 0 14px;
  }

  .partner__sub {
