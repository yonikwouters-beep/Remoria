---
/**
 * High-fidelity features grid from design_handoff_remoria/source/Home.dc.html.
 */
import { getLocale, t, tp } from '../i18n/utils';
const locale = getLocale(Astro.currentLocale);

const items = tp<{ title: string; description: string }[]>(locale, 'features.items');

const icons = [
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>`,
];
---

<section class="features">
  <div class="features__inner">
    <div class="features__header">
      <p class="features__eyebrow">{t(locale, 'features.eyebrow')}</p>
      <h2 class="features__heading">{t(locale, 'features.heading')}</h2>
    </div>

    <div class="features__grid">
      {items.map((item, i) => (
        <article class="feature-card">
          <span class="feature-card__icon" set:html={icons[i]} />
          <h3 class="feature-card__title">{item.title}</h3>
          <p class="feature-card__desc">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .features {
    background: #F6F1E8;
    padding: clamp(64px, 9vw, 88px) 24px 0;
  }

  .features__inner {
    max-width: 1180px;
    margin: 0 auto;
  }

  .features__header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 48px;
  }

  .features__eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #B8934A;
    margin-bottom: 16px;
  }

  .features__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(28px, 3vw, 40px);
    line-height: 1.15;
    color: #1C2A43;
    margin: 0;
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .feature-card {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 16px;
    padding: 28px 26px;
    transition: box-shadow 0.25s ease, transform 0.2s ease;
  }

  .feature-card:hover {
    box-shadow: 0 14px 30px -16px rgba(28, 42, 67, 0.2);
    transform: translateY(-2px);
  }

  .feature-card__icon {
    display: inline-flex;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #F3E7CF;
    color: #96742F;
    align-items: center;
    justify-content: center;
    margin-bottom: 18px;
  }

  .feature-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 18px;
    font-weight: 600;
    color: #1C2A43;
    margin: 0 0 8px;
  }

  .feature-card__desc {
    font-size: 14px;
    line-height: 1.6;
    color: #7A7263;
    margin: 0;
  }

  @media (max-width: 900px) {
    .features__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 560px) {
    .features__grid {
      grid-template-columns: 1fr;
    }

    .features__header {
      margin-bottom: 36px;
    }
  }
</style>
