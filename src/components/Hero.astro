---
/**
 * High-fidelity hero from design_handoff_remoria/source/Home.dc.html.
 */
import { getLocale, localizePath, t } from '../i18n/utils';
const locale = getLocale(Astro.currentLocale);

// `hero.heading` isn't split into three lines in the copy deck; fall back to
// the existing line-based keys if the single-string key isn't present yet.
const headingKey = 'hero.heading';
const heading =
  t(locale, headingKey) !== headingKey
    ? t(locale, headingKey)
    : [t(locale, 'hero.headingLine1'), t(locale, 'hero.headingLine2'), t(locale, 'hero.headingLine3')].join(' ');

const trustNoteKey = 'hero.trustNote';
const trustNoteRaw = t(locale, trustNoteKey);
const trustNote = trustNoteRaw !== trustNoteKey ? trustNoteRaw : null;
---

<section class="hero">
  <div class="hero__bg" style="background-image: url('/hero-visual.png')" aria-hidden="true"></div>
  <div class="hero__gradient" aria-hidden="true"></div>

  <div class="hero__inner">
    <div class="hero__content">
      <p class="hero__eyebrow">{t(locale, 'hero.eyebrow')}</p>

      <h1 class="hero__heading">{heading}</h1>

      <p class="hero__subtext">{t(locale, 'hero.subtext')}</p>

      <div class="hero__actions">
        <a href={localizePath(locale, '/prijzen')} class="btn btn-primary">
          {t(locale, 'hero.primaryCta')}
        </a>
        <a
          href="https://app.remoria.eu/demo"
          class="btn btn-secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="play-icon" aria-hidden="true">
            <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          </span>
          {t(locale, 'hero.secondaryCta')}
        </a>
      </div>

      {trustNote && (
        <div class="hero__trust">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="11" width="18" height="11" rx="2"/>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
          </svg>
          {trustNote}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-width: 0;
    background-color: #F6F1E8;
    overflow: hidden;
    overflow-x: clip;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    right: 0;
    width: 62%;
    margin-left: auto;
    background-size: cover !important;
    background-repeat: no-repeat !important;
    background-position: right center !important;
  }

  .hero__gradient {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      #F6F1E8 38%,
      rgba(246, 241, 232, 0.85) 52%,
      rgba(246, 241, 232, 0) 78%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(64px, 9vh, 96px) clamp(20px, 5vw, 24px) clamp(80px, 10vh, 110px);
  }

  .hero__content {
    max-width: 520px;
    min-width: 0;
  }

  .hero__eyebrow {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: #B8934A;
    margin-bottom: 20px;
  }

  .hero__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(2rem, 4.4vw + 0.5rem, 54px);
    line-height: 1.12;
    color: #1C2A43;
    margin: 0 0 22px;
    text-wrap: pretty;
  }

  .hero__subtext {
    font-size: 17.5px;
    line-height: 1.65;
    color: #7A7263;
    margin: 0 0 32px;
    max-width: 440px;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    padding: 15px 30px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.18s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn-primary {
    background: #1C2A43;
    color: #fff;
  }

  .btn-primary:hover {
    background: #2A3B5C;
  }

  .btn-secondary {
    background: #fff;
    color: #1C2A43;
    padding: 15px 26px;
    gap: 10px;
    border: 1px solid #E7DFD2;
  }

  .btn-secondary:hover {
    border-color: #1C2A43;
  }

  .play-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #1C2A43;
    color: #fff;
    flex-shrink: 0;
  }

  .hero__trust {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    font-size: 13px;
    color: #A79C87;
  }

  @media (max-width: 900px) {
    .hero__bg {
      width: 78%;
    }

    .hero__gradient {
      background: linear-gradient(
        90deg,
        #F6F1E8 28%,
        rgba(246, 241, 232, 0.88) 44%,
        rgba(246, 241, 232, 0.35) 62%,
        rgba(246, 241, 232, 0) 80%
      );
    }
  }

  @media (max-width: 600px) {
    .hero__inner {
      padding-top: 56px;
    }

    .hero__content {
      max-width: 100%;
    }

    .hero__bg {
      width: 100%;
      opacity: 0.22;
    }

    .hero__gradient {
      background: rgba(246, 241, 232, 0.6);
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn {
      justify-content: center;
    }
  }
</style>
