---
/**
 * AI-wallet — credits per gedenkplek voor fotobewerkingen. Kosten, pakketten en
 * credits per plan volgen src/lib/aiCredits.ts en aiCreditPackPricing.ts in de app.
 */
import { getLocale, t, tp } from '../i18n/utils';

export interface Props {
  /** Toon de losse creditpakketten (Prijzen-pagina). */
  showPacks?: boolean;
}

const { showPacks = false } = Astro.props;
const locale = getLocale(Astro.currentLocale);

type Tool = { title: string; cost: string; text: string };
type PlanCredits = { credits: string; label: string };

const tools = tp<Tool[]>(locale, 'aiWallet.tools');
const plans = tp<PlanCredits[]>(locale, 'aiWallet.plans');
const packs = tp<string[]>(locale, 'aiWallet.packs');

const toolIcons = [
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 3 21 3 21 9"/><polyline points="9 21 3 21 3 15"/><line x1="21" y1="3" x2="14" y2="10"/><line x1="3" y1="21" x2="10" y2="14"/></svg>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="13.5" cy="6.5" r="1.5"/><circle cx="17.5" cy="10.5" r="1.5"/><circle cx="8.5" cy="7.5" r="1.5"/><circle cx="6.5" cy="12.5" r="1.5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.6-.7 1.6-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1 0-.9.7-1.7 1.7-1.7H16c3.1 0 5.6-2.5 5.6-5.6C21.9 6 17.5 2 12 2z"/></svg>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  `<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>`,
];
---

<section class="ai" id="ai-wallet" aria-labelledby="ai-heading">
  <div class="ai__container">
    <p class="ai__eyebrow">{t(locale, 'aiWallet.eyebrow')}</p>
    <h2 class="ai__title" id="ai-heading">{t(locale, 'aiWallet.title')}</h2>
    <p class="ai__body">{t(locale, 'aiWallet.body')}</p>

    <div class="ai__grid">
      {tools.map((tool, i) => (
        <article class="ai-card">
          <span class="ai-card__icon" aria-hidden="true" set:html={toolIcons[i]} />
          <h3 class="ai-card__title">{tool.title}</h3>
          <p class="ai-card__cost">{tool.cost}</p>
          <p class="ai-card__text">{tool.text}</p>
        </article>
      ))}
    </div>

    <div class="ai__plans">
      {plans.map((p) => (
        <div><strong>{p.credits}</strong><span>{p.label}</span></div>
      ))}
    </div>

    {showPacks && (
      <p class="ai__packs">
        {t(locale, 'aiWallet.packsIntro')}
        {packs.map((p) => <span class="ai__pack">{p}</span>)}
        <span class="ai__packs-note">{t(locale, 'aiWallet.packsNote')}</span>
      </p>
    )}
  </div>
</section>

<style>
  .ai {
    padding: clamp(64px, 9vw, 96px) clamp(20px, 5vw, 24px);
  }

  .ai__container {
    max-width: 1180px;
    margin: 0 auto;
    text-align: center;
  }

  .ai__eyebrow {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    color: #B8934A;
    margin: 0 0 18px;
  }

  .ai__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    color: #1C2A43;
    margin: 0;
  }

  .ai__body {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16.5px;
    line-height: 1.7;
    color: #5C5548;
    margin: 18px auto clamp(32px, 5vw, 48px);
    max-width: 640px;
  }

  .ai__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    text-align: left;
  }

  .ai-card {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 16px;
    padding: 26px 22px;
  }

  .ai-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #EFE6D5;
    color: #96742F;
    margin-bottom: 16px;
  }

  .ai-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 1.15rem;
    color: #1C2A43;
    margin: 0;
  }

  .ai-card__cost {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13px;
    font-weight: 800;
    color: #96742F;
    margin: 4px 0 10px;
  }

  .ai-card__text {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14.5px;
    line-height: 1.65;
    color: #7A7263;
    margin: 0;
  }

  .ai__plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
    margin-top: 28px;
  }

  .ai__plans div {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;
    padding: 16px;
    border-radius: 14px;
    border: 1px solid rgba(184, 147, 74, 0.4);
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    color: #5C5548;
  }

  .ai__plans strong {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 26px;
    font-weight: 600;
    color: #1C2A43;
  }

  .ai__packs {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    color: #7A7263;
    margin: 24px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .ai__pack {
    padding: 4px 12px;
    border-radius: 999px;
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    color: #1C2A43;
    font-weight: 700;
  }

  .ai__packs-note {
    font-size: 12.5px;
  }

  @media (max-width: 1024px) {
    .ai__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 720px) {
    .ai__plans { grid-template-columns: 1fr; }
  }

  @media (max-width: 540px) {
    .ai__grid { grid-template-columns: 1fr; }
  }
</style>
