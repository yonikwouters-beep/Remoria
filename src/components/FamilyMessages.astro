---
/**
 * Privégesprek tussen familie en uitvaartonderneming, met foto's uit de
 * gedenkplek als bijlage. Copy volgt de berichten in app.remoria.eu.
 */
import { getLocale, t, tp } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);

type Point = { title: string; text: string };

const points = tp<Point[]>(locale, 'familyMessages.points');
---

<section class="msgs" id="berichten" aria-labelledby="msgs-heading">
  <div class="msgs__container">
    <div>
      <p class="msgs__eyebrow">{t(locale, 'familyMessages.eyebrow')}</p>
      <h2 class="msgs__title" id="msgs-heading">{t(locale, 'familyMessages.title')}</h2>
      <p class="msgs__body">{t(locale, 'familyMessages.body')}</p>

      <ul class="msgs__points">
        {points.map((p) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B8934A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span><strong>{p.title}.</strong> {p.text}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="msgs__mock" aria-hidden="true">
      <div class="msgs__mock-head">
        <strong>{t(locale, 'familyMessages.mock.header')}</strong>
        <span>{t(locale, 'familyMessages.mock.private')}</span>
      </div>

      <div class="bubble bubble--out">{t(locale, 'familyMessages.mock.question')}</div>

      <div class="bubble bubble--in">
        {t(locale, 'familyMessages.mock.answer')}
        <div class="bubble__photos">
          <span></span><span></span><span></span><span class="more">+9</span>
        </div>
      </div>

      <div class="msgs__download">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        {t(locale, 'familyMessages.mock.download')}
      </div>
    </div>
  </div>
</section>

<style>
  .msgs {
    padding: clamp(64px, 9vw, 96px) clamp(20px, 5vw, 24px);
  }

  .msgs__container {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }

  .msgs__eyebrow {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    color: #B8934A;
    margin: 0 0 18px;
  }

  .msgs__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    color: #1C2A43;
    margin: 0;
  }

  .msgs__body {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16.5px;
    line-height: 1.7;
    color: #5C5548;
    margin: 18px 0 0;
    max-width: 540px;
  }

  .msgs__points {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }

  .msgs__points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #5C5548;
  }

  .msgs__points strong {
    font-weight: 800;
    color: #1C2A43;
  }

  .msgs__points svg {
    flex-shrink: 0;
    margin-top: 4px;
  }

  .msgs__mock {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 20px;
    padding: 22px;
    box-shadow: 0 18px 48px rgba(28, 42, 67, 0.1);
    display: flex;
    flex-direction: column;
    gap: 14px;
    font-family: 'Nunito Sans', sans-serif;
  }

  .msgs__mock-head {
    display: flex;
    flex-direction: column;
    padding-bottom: 12px;
    border-bottom: 1px solid #E7DFD2;
  }

  .msgs__mock-head strong {
    font-size: 15px;
    font-weight: 800;
    color: #1C2A43;
  }

  .msgs__mock-head span {
    font-size: 12.5px;
    color: #7A7263;
  }

  .bubble {
    max-width: 85%;
    padding: 12px 14px;
    border-radius: 16px;
    font-size: 14px;
    line-height: 1.55;
  }

  .bubble--out {
    align-self: flex-end;
    background: #1C2A43;
    color: #fff;
    border-bottom-right-radius: 4px;
  }

  .bubble--in {
    align-self: flex-start;
    background: #F6F1E8;
    color: #1C2A43;
    border-bottom-left-radius: 4px;
  }

  .bubble__photos {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 6px;
    margin-top: 10px;
  }

  .bubble__photos span {
    aspect-ratio: 1;
    border-radius: 8px;
    background: linear-gradient(135deg, #EFE6D5, #D8C8A4);
  }

  .bubble__photos .more {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #1C2A43;
    color: #fff;
    font-size: 13px;
    font-weight: 800;
  }

  .msgs__download {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid rgba(184, 147, 74, 0.55);
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    color: #96742F;
  }

  @media (max-width: 900px) {
    .msgs__container { grid-template-columns: 1fr; }
  }
</style>
