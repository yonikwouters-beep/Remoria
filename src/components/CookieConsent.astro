---
/**
 * Cookiebanner + voorkeurenvenster.
 *
 * De site plaatst zelf alleen noodzakelijke gegevens (taalkeuze, deze keuze).
 * Externe diensten (nu: de Cal.com-agenda op de contactpagina) laden pas na
 * toestemming. Andere scripts vragen de keuze op via window.RemoriaConsent:
 *   RemoriaConsent.get()            → { external: boolean } | null (nog geen keuze)
 *   RemoriaConsent.request(opts)    → Promise<boolean>, vraagt toestemming voor externe diensten
 *   RemoriaConsent.open()           → opent het voorkeurenvenster
 * en luisteren naar het event 'remoria-consent' op window.
 * Weigeren is even makkelijk als toestaan (twee gelijkwaardige knoppen).
 */
import { getLocale, localizePath, t } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const c = (key: string) => t(locale, `cookies.${key}`);
const privacyUrl = localizePath(locale, '/privacy');
---

<div class="cc" id="cc-banner" role="region" aria-label={c('dialogAria')} hidden>
  <div class="cc__card">
    <div class="cc__head">
      <img src="/favicon+footer/favicon-96-transparant.png" alt="" class="cc__logo" width="32" height="32" />
      <p class="cc__title">{c('title')}</p>
    </div>
    <div class="cc__body">
      <p class="cc__text">
        {c('text')} <a href={privacyUrl}>{c('privacyLink')}</a>
      </p>
      <div class="cc__actions">
        <button type="button" class="cc__btn" data-cc="reject">{c('reject')}</button>
        <button type="button" class="cc__btn" data-cc="accept">{c('accept')}</button>
        <button type="button" class="cc__link" data-cc="settings">{c('settings')}</button>
      </div>
    </div>
  </div>
</div>

<dialog class="cc-modal" id="cc-modal" aria-labelledby="cc-modal-title">
  <form method="dialog" class="cc-modal__inner">
    <button type="submit" value="close" class="cc-modal__close" aria-label={c('close')}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
    </button>
    <img src="/favicon+footer/favicon-96-transparant.png" alt="" class="cc__logo" width="32" height="32" />
    <h2 class="cc-modal__title" id="cc-modal-title">{c('modalTitle')}</h2>
    <p class="cc-modal__intro">{c('modalIntro')}</p>

    <div class="cc-modal__row">
      <div>
        <p class="cc-modal__label">{c('necessaryTitle')}</p>
        <p class="cc-modal__desc">{c('necessaryText')}</p>
      </div>
      <span class="cc-modal__always">{c('alwaysOn')}</span>
    </div>

    <label class="cc-modal__row cc-modal__row--toggle">
      <div>
        <p class="cc-modal__label">{c('externalTitle')}</p>
        <p class="cc-modal__desc">{c('externalText')}</p>
      </div>
      <span class="cc-switch">
        <input type="checkbox" id="cc-external" />
        <span class="cc-switch__track" aria-hidden="true"></span>
      </span>
    </label>

    <div class="cc-modal__actions cc-modal__actions--grid">
      <button type="button" class="cc__btn" data-cc="reject">{c('reject')}</button>
      <button type="button" class="cc__btn" data-cc="accept">{c('accept')}</button>
      <button type="button" class="cc__btn cc__btn--solid cc__btn--wide" data-cc="save">{c('save')}</button>
    </div>
    <p class="cc-modal__privacy"><a href={privacyUrl}>{c('privacyLink')}</a></p>
  </form>
</dialog>

<dialog class="cc-modal cc-modal--small" id="cc-prompt" aria-labelledby="cc-prompt-title">
  <div class="cc-modal__inner">
    <img src="/favicon+footer/favicon-96-transparant.png" alt="" class="cc__logo" width="32" height="32" />
    <h2 class="cc-modal__title" id="cc-prompt-title"></h2>
    <p class="cc-modal__intro" id="cc-prompt-text"></p>
    <div class="cc-modal__actions cc-modal__actions--grid">
      <button type="button" class="cc__btn" data-prompt="no"></button>
      <button type="button" class="cc__btn cc__btn--solid" data-prompt="yes"></button>
    </div>
  </div>
</dialog>

<script>
  type Consent = { v: number; external: boolean; at: string };
  const KEY = 'remoria-consent';
  const VERSION = 1;

  const banner = document.getElementById('cc-banner');
  const modal = document.getElementById('cc-modal') as HTMLDialogElement | null;
  const prompt = document.getElementById('cc-prompt') as HTMLDialogElement | null;
  const externalBox = document.getElementById('cc-external') as HTMLInputElement | null;

  function read(): Consent | null {
    try {
      const raw = localStorage.getItem(KEY);
      const parsed = raw ? (JSON.parse(raw) as Consent) : null;
      return parsed && parsed.v === VERSION ? parsed : null;
    } catch {
      return null;
    }
  }

  function write(external: boolean) {
    const value: Consent = { v: VERSION, external, at: new Date().toISOString() };
    try {
      localStorage.setItem(KEY, JSON.stringify(value));
    } catch {
      /* privévenster: keuze geldt dan alleen voor dit bezoek */
    }
    current = value;
    if (banner) banner.hidden = true;
    if (modal?.open) modal.close();
    window.dispatchEvent(new CustomEvent('remoria-consent', { detail: { external } }));
  }

  let current = read();

  function openSettings() {
    if (!modal || !externalBox) return;
    externalBox.checked = !!current?.external;
    modal.showModal();
  }

  document.querySelectorAll<HTMLElement>('[data-cc]').forEach((el) => {
    el.addEventListener('click', () => {
      const action = el.dataset.cc;
      if (action === 'accept') write(true);
      else if (action === 'reject') write(false);
      else if (action === 'save') write(!!externalBox?.checked);
      else if (action === 'settings') openSettings();
    });
  });

  document.querySelectorAll<HTMLElement>('[data-cookie-settings]').forEach((el) => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      openSettings();
    });
  });

  /** Vraagt toestemming voor externe diensten op het moment dat ze nodig zijn. */
  function request(opts: { title: string; text: string; accept: string; cancel: string }): Promise<boolean> {
    if (current?.external) return Promise.resolve(true);
    if (!prompt) return Promise.resolve(false);
    const title = prompt.querySelector('#cc-prompt-title');
    const text = prompt.querySelector('#cc-prompt-text');
    const yes = prompt.querySelector<HTMLButtonElement>('[data-prompt="yes"]');
    const no = prompt.querySelector<HTMLButtonElement>('[data-prompt="no"]');
    if (!title || !text || !yes || !no) return Promise.resolve(false);
    title.textContent = opts.title;
    text.textContent = opts.text;
    yes.textContent = opts.accept;
    no.textContent = opts.cancel;
    return new Promise((resolve) => {
      const done = (ok: boolean) => {
        yes.onclick = no.onclick = null;
        prompt.onclose = null;
        if (prompt.open) prompt.close();
        if (ok) write(true);
        resolve(ok);
      };
      yes.onclick = () => done(true);
      no.onclick = () => done(false);
      prompt.onclose = () => done(false);
      prompt.showModal();
    });
  }

  (window as unknown as { RemoriaConsent: unknown }).RemoriaConsent = {
    get: () => (current ? { external: current.external } : null),
    request,
    open: openSettings,
  };

  if (!current && banner) banner.hidden = false;
</script>

<style>
  .cc {
    position: fixed;
    left: 24px;
    bottom: 24px;
    z-index: 1000;
    max-width: 400px;
    width: calc(100% - 48px);
    animation: cc-in 0.5s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .cc[hidden] {
    display: none;
  }

  @keyframes cc-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: none; }
  }

  .cc__card {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 16px;
    padding: 18px 20px 14px;
    box-shadow: 0 12px 32px -18px rgba(28, 42, 67, 0.28);
    font-family: 'Nunito Sans', sans-serif;
  }

  .cc__head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .cc__logo {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
  }

  .cc__title,
  .cc-modal__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 16.5px;
    line-height: 1.3;
    color: #1C2A43;
    margin: 0;
  }

  .cc__text {
    font-size: 13px;
    line-height: 1.6;
    color: #6B6353;
    margin: 0 0 14px;
  }

  .cc__text a,
  .cc-modal__privacy a {
    color: #96742F;
    font-weight: 700;
  }

  .cc__actions,
  .cc-modal__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 8px;
  }

  .cc__actions .cc__btn {
    flex: 1 1 0;
    min-width: max-content;
  }

  .cc__actions .cc__link {
    flex-basis: 100%;
    text-align: center;
  }

  .cc-modal__actions--grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .cc__btn--wide {
    grid-column: 1 / -1;
  }

  /* Beide keuzes zien er hetzelfde uit: weigeren is even makkelijk als toestaan. */
  .cc__btn {
    border: none;
    cursor: pointer;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 700;
    line-height: 1.25;
    padding: 10px 16px;
    border-radius: 999px;
    background: transparent;
    color: #1C2A43;
    box-shadow: inset 0 0 0 1px rgba(28, 42, 67, 0.35);
    transition: background-color 0.2s ease, box-shadow 0.2s ease, color 0.2s ease;
  }

  .cc__btn:hover {
    background: rgba(28, 42, 67, 0.05);
    box-shadow: inset 0 0 0 1px #1C2A43;
  }

  .cc__btn--solid {
    background: #1C2A43;
    color: #fff;
    box-shadow: none;
  }

  .cc__btn--solid:hover {
    background: #2A3B5C;
    box-shadow: none;
  }

  .cc__link {
    background: none;
    border: none;
    cursor: pointer;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    color: #7A7263;
    text-decoration: underline;
    text-underline-offset: 3px;
    padding: 8px 4px 2px;
  }

  .cc__link:hover {
    color: #1C2A43;
  }

  .cc__btn:focus-visible,
  .cc__link:focus-visible,
  .cc-modal__close:focus-visible {
    outline: 2px solid #B8934A;
    outline-offset: 2px;
  }

  /* ── Voorkeurenvenster ── */
  .cc-modal {
    border: none;
    margin: auto;
    padding: 0;
    border-radius: 18px;
    background: #FDFBF7;
    color: #4A4438;
    width: min(480px, calc(100% - 32px));
    max-height: calc(100dvh - 32px);
    box-shadow: 0 24px 60px -24px rgba(28, 42, 67, 0.4);
    font-family: 'Nunito Sans', sans-serif;
  }

  .cc-modal::backdrop {
    background: rgba(28, 42, 67, 0.35);
  }

  .cc-modal__inner {
    position: relative;
    padding: 26px 26px 22px;
  }

  .cc-modal__close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: none;
    background: transparent;
    color: #7A7263;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .cc-modal__close:hover {
    background: rgba(28, 42, 67, 0.06);
  }

  .cc-modal__inner > .cc__logo {
    width: 32px;
    height: 32px;
  }

  .cc-modal__title {
    font-size: 20px;
    margin: 10px 0 6px;
  }

  .cc-modal__intro {
    font-size: 13.5px;
    line-height: 1.6;
    color: #6B6353;
    margin: 0 0 16px;
  }

  .cc-modal__row {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    border: 1px solid #E7DFD2;
    background: #fff;
    border-radius: 12px;
    padding: 12px 14px;
    margin-bottom: 8px;
  }

  .cc-modal__row--toggle {
    cursor: pointer;
  }

  .cc-modal__label {
    font-size: 14px;
    font-weight: 700;
    color: #1C2A43;
    margin: 0 0 2px;
  }

  .cc-modal__desc {
    font-size: 12.5px;
    line-height: 1.55;
    color: #7A7263;
    margin: 0;
  }

  .cc-modal__always {
    flex-shrink: 0;
    font-size: 11.5px;
    font-weight: 700;
    color: #7A7263;
    background: #F3EEE5;
    border-radius: 999px;
    padding: 4px 10px;
  }

  .cc-switch {
    position: relative;
    flex-shrink: 0;
    width: 42px;
    height: 24px;
  }

  .cc-switch input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  .cc-switch__track {
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: #D8D0C2;
    transition: background-color 0.2s ease;
    pointer-events: none;
  }

  .cc-switch__track::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 3px rgba(28, 42, 67, 0.25);
    transition: transform 0.2s ease;
  }

  .cc-switch input:checked + .cc-switch__track {
    background: #1C2A43;
  }

  .cc-switch input:checked + .cc-switch__track::after {
    transform: translateX(18px);
  }

  .cc-switch input:focus-visible + .cc-switch__track {
    outline: 2px solid #B8934A;
    outline-offset: 2px;
  }

  .cc-modal__actions {
    margin-top: 16px;
  }

  .cc-modal__privacy {
    margin: 12px 0 0;
    font-size: 12.5px;
    text-align: center;
  }

  @media (max-width: 560px) {
    .cc {
      left: 12px;
      right: 12px;
      bottom: 12px;
      width: auto;
      max-width: none;
    }

    .cc__card {
      padding: 16px 16px 10px;
    }

    .cc__actions .cc__btn {
      padding: 10px 8px;
      min-width: 0;
    }

    .cc-modal__inner {
      padding: 22px 18px 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cc {
      animation: none;
    }
  }
</style>
