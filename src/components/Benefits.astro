---
/**
 * High-fidelity "Doelgroepen" section from design_handoff_remoria/source/Home.dc.html.
 */
import { getLocale, localizePath, t, tp } from '../i18n/utils';
import PhoneMockup from './PhoneMockup.astro';
import PartnerDashboardMockup from './PartnerDashboardMockup.astro';

const locale = getLocale(Astro.currentLocale);

type Benefit = {
  label: string;
  heading: string;
  intro?: string;
  items: string[];
  cta: string;
};

const bereaved = tp<Benefit>(locale, 'benefits.bereaved');
const funeral = tp<Benefit>(locale, 'benefits.funeral');
---

<section class="benefits">
  <div class="benefits__inner">

    <!-- Nabestaanden -->
    <div class="panel panel--bereaved">
      <div class="panel__grid">
        <div class="panel__text">
          <p class="panel__label panel__label--gold">{bereaved.label}</p>
          <h3 class="panel__heading" set:html={bereaved.heading.replace(/\n/g, '<br />')} />
          {bereaved.intro && <p class="panel__intro">{bereaved.intro}</p>}

          <ul class="panel__list">
            {bereaved.items.map((item) => (
              <li>
                <span class="check check--gold" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>

          <a href={localizePath(locale, '/voor-nabestaanden')} class="panel__cta">
            {bereaved.cta} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="panel__visual panel__visual--phone">
          <PhoneMockup />
        </div>
      </div>
    </div>

    <!-- Uitvaartsector -->
    <div class="panel panel--funeral">
      <div class="panel__grid">
        <div class="panel__text">
          <p class="panel__label panel__label--blue">{funeral.label}</p>
          <h3 class="panel__heading" set:html={funeral.heading.replace(/\n/g, '<br />')} />
          {funeral.intro && <p class="panel__intro">{funeral.intro}</p>}

          <ul class="panel__list">
            {funeral.items.map((item) => (
              <li>
                <span class="check check--blue" aria-hidden="true">✓</span>
                {item}
              </li>
            ))}
          </ul>

          <a href={localizePath(locale, '/voor-uitvaartsector')} class="panel__cta">
            {funeral.cta} <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="panel__visual panel__visual--dashboard">
          <PartnerDashboardMockup variant="compact" />
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .benefits {
    background: #F6F1E8;
    padding: clamp(48px, 6vw, 64px) 24px clamp(64px, 9vw, 88px);
  }

  .benefits__inner {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr));
    gap: 20px;
  }

  .panel {
    border-radius: 24px;
    overflow: hidden;
  }

  .panel--bereaved {
    background: #EFE6D5 url('/flowers-background.webp') left bottom / cover no-repeat;
    padding: 34px 32px;
  }

  .panel--funeral {
    background: #E2E7EC;
    padding: 34px 0 34px 32px;
  }

  .panel__grid {
    display: grid;
    gap: 24px;
    align-items: center;
    min-height: 100%;
  }

  .panel--bereaved .panel__grid {
    grid-template-columns: minmax(0, 1fr) 195px;
  }

  .panel--funeral .panel__grid {
    grid-template-columns: minmax(0, 1fr) 274px;
    gap: 22px;
  }

  .panel__text {
    align-self: start;
    min-width: 0;
  }

  .panel__label {
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin: 0 0 14px;
  }

  .panel__label--gold {
    color: #96742F;
  }

  .panel__label--blue {
    color: #4A6E8C;
  }

  .panel__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: 24px;
    line-height: 1.2;
    color: #1C2A43;
    margin: 0 0 12px;
  }

  .panel__intro {
    font-size: 14px;
    line-height: 1.6;
    color: #7A7263;
    margin: 0 0 14px;
  }

  .panel__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    margin: 0 0 24px;
    padding: 0;
  }

  .panel__list li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: 14px;
    font-weight: 600;
    color: #4A4438;
  }

  .check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    color: #fff;
    font-size: 10px;
    flex-shrink: 0;
  }

  .check--gold {
    background: #B8934A;
  }

  .check--blue {
    background: #4A6E8C;
  }

  .panel__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #1C2A43;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    padding: 12px 24px;
    border-radius: 999px;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.2s ease, transform 0.18s ease;
  }

  .panel__cta:hover {
    background: #2A3B5C;
    transform: translateY(-2px);
  }

  .panel__visual {
    min-width: 0;
    display: flex;
    justify-content: center;
  }

  .panel__visual--phone {
    align-self: end;
    justify-content: flex-start;
    width: 195px;
  }

  .panel__visual--dashboard {
    justify-content: flex-end;
    width: 274px;
  }

  @media (max-width: 640px) {
    .panel--bereaved,
    .panel--funeral {
      padding: 28px 24px;
    }

    .panel__grid {
      grid-template-columns: 1fr !important;
      gap: 28px;
    }

    .panel__text {
      order: 1;
    }

    .panel__visual {
      order: 2;
      justify-content: center;
      width: auto;
    }

    .panel__visual--phone {
      align-self: center;
    }

    :global(.phone) {
      margin-bottom: 0;
    }
  }
</style>
