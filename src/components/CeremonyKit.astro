---
/**
 * Ceremoniekit — drukklare QR-affiches, tafelkaartjes en beelden voor de
 * afscheidsdienst. Formaten en stijlen volgen de kit in app.remoria.eu.
 */
import { getLocale, t, tp } from '../i18n/utils';

export interface Props {
  audience?: 'family' | 'funeral';
}

const { audience = 'family' } = Astro.props;
const locale = getLocale(Astro.currentLocale);

type Format = { name: string; sub: string };

const formats = tp<Format[]>(locale, 'ceremonyKit.formats');
const points = tp<string[]>(locale, `ceremonyKit.points.${audience}`);
---

<section class="kit" id="ceremoniekit" aria-labelledby="kit-heading">
  <div class="kit__container">
    <div>
      <p class="kit__eyebrow">{t(locale, 'ceremonyKit.eyebrow')}</p>
      <h2 class="kit__title" id="kit-heading">{t(locale, 'ceremonyKit.title')}</h2>
      <p class="kit__body">{t(locale, `ceremonyKit.body.${audience}`)}</p>

      <ul class="kit__points">
        {points.map((p) => (
          <li>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B8934A" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
            <span>{p}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="kit__side">
      <div class="kit__poster" aria-hidden="true">
        <p class="kit__poster-kicker">{t(locale, 'ceremonyKit.posterKicker')}</p>
        <p class="kit__poster-name">Marie Peeters</p>
        <svg class="kit__poster-qr" viewBox="0 0 21 21" shape-rendering="crispEdges">
          <path fill="#1C2A43" d="M0 0h7v7H0zM1 1v5h5V1zM2 2h3v3H2zM14 0h7v7h-7zM15 1v5h5V1zM16 2h3v3h-3zM0 14h7v7H0zM1 15v5h5v-5zM2 16h3v3H2zM8 0h2v2H8zM11 1h2v3h-2zM8 3h2v2H8zM9 6h3v2H9zM8 9h4v2H8zM13 8h2v3h-2zM16 8h5v2h-5zM0 8h3v2H0zM4 9h3v2H4zM9 12h2v3H9zM12 12h3v2h-3zM17 11h2v3h-2zM13 15h2v3h-2zM16 15h5v2h-5zM8 16h3v2H8zM9 19h4v2H9zM17 18h2v3h-2zM20 19h1v2h-1z"/>
        </svg>
        <p class="kit__poster-msg">{t(locale, 'ceremonyKit.posterMessage')}</p>
      </div>

      <ul class="kit__formats">
        {formats.map((f) => (
          <li>
            <strong>{f.name}</strong>
            <span>{f.sub}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .kit {
    background: #FDFBF7;
    border-block: 1px solid #E7DFD2;
    padding: clamp(64px, 9vw, 96px) clamp(20px, 5vw, 24px);
  }

  .kit__container {
    max-width: 1180px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(36px, 5vw, 64px);
    align-items: center;
  }

  .kit__eyebrow {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.155em;
    text-transform: uppercase;
    color: #B8934A;
    margin: 0 0 18px;
  }

  .kit__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.8rem, 3.2vw, 2.5rem);
    line-height: 1.15;
    color: #1C2A43;
    margin: 0;
  }

  .kit__body {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16.5px;
    line-height: 1.7;
    color: #5C5548;
    margin: 18px 0 0;
    max-width: 540px;
  }

  .kit__points {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  .kit__points li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    line-height: 1.6;
    color: #4A4438;
  }

  .kit__points svg {
    flex-shrink: 0;
    margin-top: 4px;
  }

  .kit__side {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    align-items: center;
  }

  .kit__poster {
    aspect-ratio: 210 / 297;
    background: #F6F1E8;
    border: 1px solid rgba(184, 147, 74, 0.4);
    border-radius: 6px;
    box-shadow: 0 18px 48px rgba(28, 42, 67, 0.12);
    padding: 18px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 8px;
  }

  .kit__poster-kicker {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #B8934A;
    margin: 0;
  }

  .kit__poster-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 17px;
    color: #1C2A43;
    margin: 0;
  }

  .kit__poster-qr {
    width: 72px;
    height: 72px;
    background: #fff;
    padding: 5px;
    border-radius: 4px;
    margin: 6px 0;
  }

  .kit__poster-msg {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 9.5px;
    line-height: 1.4;
    color: #5C5548;
    margin: 0;
  }

  .kit__formats {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .kit__formats li {
    display: flex;
    flex-direction: column;
    background: #F6F1E8;
    border-radius: 12px;
    padding: 10px 14px;
    font-family: 'Nunito Sans', sans-serif;
  }

  .kit__formats strong {
    font-size: 14.5px;
    font-weight: 700;
    color: #1C2A43;
  }

  .kit__formats span {
    font-size: 13px;
    color: #7A7263;
  }

  @media (max-width: 900px) {
    .kit__container { grid-template-columns: 1fr; }
  }

  @media (max-width: 480px) {
    .kit__side { grid-template-columns: 1fr; }
    .kit__poster { width: 180px; margin: 0 auto; }
  }
</style>
