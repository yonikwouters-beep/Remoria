---
import { getLocale, localizePath, t } from '../i18n/utils';
const locale = getLocale(Astro.currentLocale);
---

<footer class="footer">
  <div class="footer__container">

    <!-- ── TOP GRID ── -->
    <div class="footer__grid">

      <!-- Col 1: Brand -->
      <div class="footer__brand">
        <a href={localizePath(locale, '/')} class="footer__logo-link" aria-label={t(locale, 'footer.logoAria')}>
          <img
            src="/logo-remoria-footer.svg"
            alt={t(locale, 'footer.logoAlt')}
            class="footer__logo-img"
            width="360"
            height="108"
          />
        </a>
        <p class="footer__tagline">
          {t(locale, 'footer.taglineLine1')}<br />{t(locale, 'footer.taglineLine2')}
        </p>
      </div>

      <!-- Col 2: Product -->
      <div class="footer__col">
        <p class="footer__heading">{t(locale, 'footer.productHeading')}</p>
        <ul class="footer__links">
          <li><a href={localizePath(locale, '/voor-nabestaanden#hoe-werkt-het')} class="footer__link">{t(locale, 'footer.howItWorks')}</a></li>
          <li><a href={localizePath(locale, '/voor-nabestaanden#fotoboek')} class="footer__link">{t(locale, 'footer.photoBook')}</a></li>
        </ul>
      </div>

      <!-- Col 3: Voor wie? -->
      <div class="footer__col">
        <p class="footer__heading">{t(locale, 'footer.forWhoHeading')}</p>
        <ul class="footer__links">
          <li><a href={localizePath(locale, '/voor-nabestaanden')} class="footer__link">{t(locale, 'footer.forBereaved')}</a></li>
          <li><a href={localizePath(locale, '/voor-uitvaartsector')} class="footer__link">{t(locale, 'footer.forFuneral')}</a></li>
        </ul>
      </div>

      <!-- Col 4: Over Remoria -->
      <div class="footer__col">
        <p class="footer__heading">{t(locale, 'footer.aboutHeading')}</p>
        <ul class="footer__links">
          <li><a href={localizePath(locale, '/over-ons')} class="footer__link">{t(locale, 'footer.aboutUs')}</a></li>
          <li><a href={localizePath(locale, '/contact')} class="footer__link">{t(locale, 'footer.contact')}</a></li>
        </ul>
      </div>

      <!-- Col 5: Newsletter -->
      <div class="footer__col">
        <p class="footer__heading">{t(locale, 'footer.newsletterHeading')}</p>
        <p class="footer__newsletter-desc">
          {t(locale, 'footer.newsletterDesc')}
        </p>
        <form
          class="footer__form"
          id="footer-newsletter-form"
          novalidate
          data-msg-success={t(locale, 'footer.newsletterSuccess')}
          data-msg-error={t(locale, 'footer.newsletterError')}
          data-msg-invalid={t(locale, 'footer.newsletterInvalid')}
        >
          <div class="footer__input-wrap">
            <input
              type="email"
              name="email"
              class="footer__input"
              placeholder={t(locale, 'footer.emailPlaceholder')}
              aria-label={t(locale, 'footer.emailAria')}
              autocomplete="email"
              required
            />
            <button type="submit" class="footer__submit" aria-label={t(locale, 'footer.subscribeAria')}>
              <svg width="15" height="15" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
          <!-- Honeypot -->
          <input
            type="text"
            name="website"
            class="footer__honeypot"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
          />
          <p class="footer__newsletter-status" id="footer-newsletter-status" role="status" hidden></p>
        </form>
        <p class="footer__newsletter-note">
          {t(locale, 'footer.newsletterNoteBefore')}<a
            href="/Remoria-Privacyverklaring.pdf"
            class="footer__newsletter-note-link"
            target="_blank"
            rel="noopener noreferrer"
          >{t(locale, 'footer.privacyLink')}</a>{t(locale, 'footer.newsletterNoteAfter')}
        </p>
      </div>

    </div>

    <!-- ── BOTTOM BAR ── -->
    <div class="footer__bottom">
      <p class="footer__copy">
        &copy; {new Date().getFullYear()} {t(locale, 'footer.copyright')}
        <span class="footer__vat" aria-label={t(locale, 'footer.vatAria')}>{t(locale, 'footer.vat')}</span>
      </p>
      <nav class="footer__legal" aria-label={t(locale, 'footer.legalAria')}>
        <a
          href="/Remoria-Privacyverklaring.pdf"
          class="footer__legal-link"
          target="_blank"
          rel="noopener noreferrer"
        >{t(locale, 'footer.privacy')}</a>
        <a
          href="/Remoria-Algemene-Voorwaarden.pdf"
          class="footer__legal-link"
          target="_blank"
          rel="noopener noreferrer"
        >{t(locale, 'footer.terms')}</a>
      </nav>
    </div>

  </div>
</footer>

<style>
  .footer {
    background-color: #1a2235;
    padding-top: clamp(48px, 7vw, 72px);
    width: 100%;
    max-width: 100%;
  }

  .footer__container {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
    padding-left: clamp(20px, 5vw, 48px);
    padding-right: clamp(20px, 5vw, 48px);
  }

  /* ── Grid ── */
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr 1.6fr;
    gap: 40px;
    padding-bottom: clamp(40px, 6vw, 56px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* ── Brand ── */
  .footer__logo-link {
    display: inline-block;
    margin-bottom: 14px;
    text-decoration: none;
  }

  .footer__logo-img {
    height: 80px;
    width: auto;
    display: block;
    opacity: 0.92;
  }

  .footer__tagline {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.55);
    margin-bottom: 0;
  }

  /* ── Link columns ── */
  .footer__col {
    display: flex;
    flex-direction: column;
  }

  .footer__heading {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #ffffff;
    margin-bottom: 16px;
    letter-spacing: 0.01em;
  }

  .footer__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer__link {
    font-family: 'Inter', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.58);
    text-decoration: none;
    transition: color 0.16s ease;
    display: inline-block;
  }

  .footer__link:hover {
    color: rgba(255, 255, 255, 0.9);
  }

  /* ── Newsletter ── */
  .footer__newsletter-desc {
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.65;
    margin-bottom: 14px;
  }

  .footer__input-wrap {
    display: flex;
    align-items: stretch;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
    transition: border-color 0.2s ease;
  }

  .footer__input-wrap:focus-within {
    border-color: rgba(198, 162, 75, 0.55);
  }

  .footer__input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: none;
    outline: none;
    padding: 11px 14px;
    font-family: 'Inter', sans-serif;
    font-size: 13.5px;
    color: #fff;
  }

  .footer__input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }

  .footer__submit {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    background: #C6A24B;
    border: none;
    cursor: pointer;
    color: #fff;
    transition: background-color 0.18s ease;
  }

  .footer__submit:hover {
    background: #b8913e;
  }

  .footer__honeypot {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .footer__newsletter-status {
    margin-top: 10px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    line-height: 1.45;
  }

  .footer__newsletter-status[hidden] {
    display: none;
  }

  .footer__newsletter-status--ok {
    color: #9fd4a8;
  }

  .footer__newsletter-status--err {
    color: #f0a8a8;
  }

  .footer__newsletter-note {
    margin-top: 12px;
    font-family: 'Inter', sans-serif;
    font-size: 12px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.38);
  }

  .footer__newsletter-note-link {
    color: rgba(255, 255, 255, 0.55);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color 0.16s ease;
  }

  .footer__newsletter-note-link:hover {
    color: rgba(255, 255, 255, 0.85);
  }

  /* ── Bottom bar ── */
  .footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    padding-bottom: 24px;
  }

  .footer__copy {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.35);
  }

  .footer__vat {
    display: inline-block;
    margin-left: 10px;
    padding-left: 10px;
    border-left: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.35);
  }

  .footer__legal {
    display: flex;
    gap: 20px;
  }

  .footer__legal-link {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.42);
    text-decoration: none;
    transition: color 0.16s ease;
  }

  .footer__legal-link:hover {
    color: rgba(255, 255, 255, 0.8);
  }

  /* ── Responsive ── */
  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr 1fr;
      gap: 32px;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }

    .footer__col:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }

    .footer__vat {
      display: block;
      margin-left: 0;
      margin-top: 6px;
      padding-left: 0;
      border-left: none;
    }
  }

  @media (max-width: 380px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('footer-newsletter-form');
  const statusEl = document.getElementById('footer-newsletter-status');
  if (form instanceof HTMLFormElement && statusEl) {
    const msgSuccess = form.dataset.msgSuccess || '';
    const msgError = form.dataset.msgError || '';
    const msgInvalid = form.dataset.msgInvalid || '';
    const emailInput = form.querySelector('input[name="email"]');
    const submitBtn = form.querySelector('button[type="submit"]');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!(emailInput instanceof HTMLInputElement) || !(submitBtn instanceof HTMLButtonElement)) return;

      const email = emailInput.value.trim();
      statusEl.hidden = true;
      statusEl.classList.remove('footer__newsletter-status--ok', 'footer__newsletter-status--err');

      if (!email || !emailInput.checkValidity()) {
        statusEl.textContent = msgInvalid;
        statusEl.classList.add('footer__newsletter-status--err');
        statusEl.hidden = false;
        emailInput.focus();
        return;
      }

      const honeypot = form.querySelector('input[name="website"]');
      const website = honeypot instanceof HTMLInputElement ? honeypot.value : '';

      submitBtn.disabled = true;
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, website }),
        });
        const result = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(result.error || 'Request failed');

        form.reset();
        statusEl.textContent = msgSuccess;
        statusEl.classList.add('footer__newsletter-status--ok');
        statusEl.hidden = false;
      } catch {
        statusEl.textContent = msgError;
        statusEl.classList.add('footer__newsletter-status--err');
        statusEl.hidden = false;
      } finally {
        submitBtn.disabled = false;
      }
    });
  }
</script>
