---
export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title: string;
  items: FaqItem[];
  id?: string;
}

const { title, items, id = 'faq' } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="faq" id={id} aria-labelledby={`${id}-heading`}>
  <div class="faq__container">
    <h2 class="faq__title" id={`${id}-heading`}>{title}</h2>

    <div class="faq__list">
      {items.map((item, i) => (
        <details class="faq__item">
          <summary class="faq__trigger">
            <span class="faq__question">{item.question}</span>
            <span class="faq__chevron" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="#B8934A" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
              </svg>
            </span>
          </summary>
          <p class="faq__answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<style>
  .faq {
    padding-block: clamp(64px, 8vw, 80px) clamp(64px, 9vw, 104px);
    background: transparent;
  }

  .faq__container {
    max-width: 720px;
    margin-inline: auto;
    padding-inline: 24px;
  }

  .faq__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.75rem, 3.2vw, 34px);
    font-weight: 600;
    color: #1C2A43;
    letter-spacing: -0.01em;
    line-height: 1.15;
    text-align: center;
    margin: 0 0 32px;
  }

  .faq__list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .faq__item {
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 12px;
    padding: 0 22px;
  }

  .faq__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 17px 0;
    cursor: pointer;
    list-style: none;
  }

  .faq__trigger::-webkit-details-marker {
    display: none;
  }

  .faq__question {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 15px;
    font-weight: 700;
    color: #1C2A43;
    line-height: 1.4;
  }

  .faq__chevron {
    flex-shrink: 0;
    display: inline-flex;
    transition: transform 0.2s ease;
  }

  .faq__item[open] .faq__chevron {
    transform: rotate(180deg);
  }

  .faq__answer {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #7A7263;
    line-height: 1.7;
    margin: 0;
    padding: 0 0 18px;
  }

  @media (max-width: 600px) {
    .faq__item {
      padding: 0 16px;
    }

    .faq__question {
      font-size: 14.5px;
    }
  }
</style>
