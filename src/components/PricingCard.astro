---
import { getLocale, t } from '../i18n/utils';
const locale = getLocale(Astro.currentLocale);

export interface Props {
  image: string;
  imageAlt: string;
  title: string;
  duration: string;
  price: string;
  monthlyPrice?: string;
  description: string;
  featured?: boolean;
  startUrl?: string;
  credits?: string;
}

const {
  image,
  imageAlt,
  title,
  duration,
  price,
  monthlyPrice = '',
  description,
  featured = false,
  startUrl = '#',
  credits,
} = Astro.props;
---

<article class:list={['pricing-card', featured && 'pricing-card--featured']}>
  {featured && (
    <span class="pricing-card__badge">{t(locale, 'pricingCard.featuredBadge')}</span>
  )}

  <img
    src={image}
    alt={imageAlt}
    class="pricing-card__img"
    loading="lazy"
    decoding="async"
  />

  <h3 class="pricing-card__title">{title}</h3>
  <p class="pricing-card__duration">{duration}</p>
  <p class="pricing-card__price">{price}</p>
  {monthlyPrice && <p class="pricing-card__monthly">{monthlyPrice}</p>}
  <p class="pricing-card__desc">{description}</p>
  {credits && (
    <p class="pricing-card__credits">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/><path d="M19 17l.8 2.2L22 20l-2.2.8L19 23l-.8-2.2L16 20l2.2-.8z"/></svg>
      <span set:html={credits} />
    </p>
  )}

  <a
    href={startUrl}
    class:list={['pricing-card__btn', featured ? 'pricing-card__btn--gold' : 'pricing-card__btn--outline']}
  >
    {t(locale, 'pricingCard.startCta')}
  </a>
</article>

<style>
  .pricing-card__credits {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: center;
    margin: 0 0 20px;
    padding: 7px 14px;
    border-radius: 999px;
    background: #EFE6D5;
    color: #7A5E24;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13.5px;
    font-weight: 600;
  }

  .pricing-card__credits :global(strong) {
    font-weight: 800;
  }

  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: center;
    background: #FDFBF7;
    border: 1px solid #E7DFD2;
    border-radius: 20px;
    padding: 36px 30px 30px;
  }

  .pricing-card--featured {
    border: 2px solid #1C2A43;
    box-shadow: 0 22px 44px -20px rgba(28, 42, 67, 0.3);
  }

  .pricing-card__badge {
    position: absolute;
    top: -13px;
    left: 50%;
    transform: translateX(-50%);
    background: #D9B36A;
    color: #3D2F14;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
    padding: 5px 16px;
    border-radius: 999px;
    white-space: nowrap;
  }

  .pricing-card__img {
    width: 96px;
    height: 96px;
    object-fit: contain;
    align-self: center;
    margin-bottom: 14px;
  }

  .pricing-card__title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 21px;
    font-weight: 600;
    color: #1C2A43;
    margin: 0;
  }

  .pricing-card__duration {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: #B8934A;
    text-transform: uppercase;
    margin: 6px 0 16px;
  }

  .pricing-card__price {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 46px;
    font-weight: 600;
    color: #1C2A43;
    line-height: 1;
    margin: 0;
  }

  .pricing-card__monthly {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12.5px;
    color: #A79C87;
    margin: 8px 0 16px;
  }

  .pricing-card__desc {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14px;
    line-height: 1.65;
    color: #7A7263;
    margin: 0 0 24px;
    text-wrap: pretty;
    flex: 1;
  }

  .pricing-card__btn {
    margin-top: auto;
    display: block;
    text-align: center;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 14.5px;
    font-weight: 800;
    padding: 13px 20px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .pricing-card__btn--outline {
    background: #FDFBF7;
    color: #1C2A43;
    border: 1.5px solid #C6BBA4;
  }

  .pricing-card__btn--outline:hover {
    border-color: #1C2A43;
    color: #1C2A43;
  }

  .pricing-card__btn--gold {
    background: #D9B36A;
    color: #1C2A43;
    padding: 14px 20px;
    border: none;
  }

  .pricing-card__btn--gold:hover {
    background: #E3C285;
    color: #1C2A43;
  }
</style>
