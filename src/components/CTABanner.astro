---
/**
 * High-fidelity dark CTA banner from design_handoff_remoria/source/Home.dc.html.
 */
import { getLocale, localizePath, t } from '../i18n/utils';
const locale = getLocale(Astro.currentLocale);
---

<section class="cta">
  <div class="cta__inner">
    <svg class="cta__mark" width="44" height="60" viewBox="0 0 44 60" fill="none" stroke="#D9B36A" stroke-width="1.4" aria-hidden="true">
      <path d="M4 58V22a18 18 0 0 1 36 0v36"/>
      <circle cx="22" cy="14" r="1.6" fill="#D9B36A"/>
    </svg>

    <h2 class="cta__heading" set:html={t(locale, 'ctaBanner.heading').replace(/\n/g, '<br />')} />
    <p class="cta__subtext">{t(locale, 'ctaBanner.subtext')}</p>

    <a href={localizePath(locale, '/prijzen')} class="cta__btn">
      {t(locale, 'ctaBanner.cta')} <span aria-hidden="true">→</span>
    </a>

    <p class="cta__note">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2"/>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
      </svg>
      {t(locale, 'ctaBanner.note')}
    </p>
  </div>
</section>

<style>
  .cta {
    background: #1C2A43;
    padding: clamp(64px, 10vw, 96px) 24px;
  }

  .cta__inner {
    max-width: 640px;
    margin: 0 auto;
    text-align: center;
  }

  .cta__mark {
    margin-bottom: 24px;
  }

  .cta__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    font-size: clamp(28px, 3.4vw, 38px);
    line-height: 1.2;
    color: #fff;
    margin: 0 0 16px;
    text-wrap: pretty;
  }

  .cta__subtext {
    font-size: 16px;
    line-height: 1.65;
    color: #B9AE97;
    margin: 0 0 30px;
  }

  .cta__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #D9B36A;
    color: #1C2A43;
    font-size: 15px;
    font-weight: 800;
    padding: 15px 32px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.18s ease;
  }

  .cta__btn:hover {
    background: #E3C285;
    transform: translateY(-2px);
  }

  .cta__note {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    font-size: 13px;
    color: #8B8268;
  }

  @media (max-width: 540px) {
    .cta {
      padding: 64px 24px 72px;
    }

    .cta__mark {
      width: 36px;
      height: 49px;
    }
  }
</style>
