---
import { getLocale, localizePath, stripLocalePrefix, locales, t } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import CookieConsent from '../components/CookieConsent.astro';
// Lettertypes zelf gehost (geen verzoeken naar Google Fonts, dus geen IP-adressen naar Google).
import '@fontsource/playfair-display/400.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/500-italic.css';
import '@fontsource/nunito-sans/400.css';
import '@fontsource/nunito-sans/600.css';
import '@fontsource/nunito-sans/700.css';
import '@fontsource/nunito-sans/800.css';
import '@fontsource/inter/300.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';

export interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.currentLocale);
const {
  title = t(locale, 'meta.defaultTitle'),
  description = t(locale, 'meta.defaultDescription'),
} = Astro.props;

const pathname = stripLocalePrefix(Astro.url.pathname);
const pathForLocale = pathname === '/' ? '' : pathname.replace(/^\//, '');
const siteUrl = Astro.site ?? Astro.url.origin;
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(`/og-${locale}.jpg`, siteUrl).href;
const ogLocale = { nl: 'nl_BE', en: 'en_GB', fr: 'fr_BE' }[locale];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon+footer/favicon-32-creme-tegel.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon+footer/favicon-512-creme-tegel.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Remoria" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />

    {locales.map((loc) => (
      <link
        rel="alternate"
        hreflang={loc}
        href={new URL(getRelativeLocaleUrl(loc, pathForLocale || undefined), siteUrl).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath('nl', pathname), siteUrl).href}
    />
  </head>
  <body>
    <div class="site-wrap">
      <slot />
    </div>
    <CookieConsent />
  </body>
</html>

<style is:global>
  :root {
    --nav-height-desktop: 132px;
    --nav-height-mobile: 100px;
    --nav-height: var(--nav-height-desktop);
  }

  @media (max-width: 768px) {
    :root {
      --nav-height: var(--nav-height-mobile);
    }
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    background-color: #F5F2EC;
    color: #1E293B;
    line-height: 1.6;
    min-height: 100vh;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
  }

  /* Alle tekst breekt veilig af */
  h1, h2, h3, h4, h5, h6, p, li, a {
    overflow-wrap: break-word;
    word-break: break-word;
  }

  img, video {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    position: relative;
  }
</style>
