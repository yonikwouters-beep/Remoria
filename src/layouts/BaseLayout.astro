---
import SiteNotice from '../components/SiteNotice.astro';
import { getLocale, localizePath, stripLocalePrefix, locales, t } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

export interface Props {
  title?: string;
  description?: string;
}

const locale = getLocale(Astro.currentLocale);
const {
  title = t(locale, 'meta.defaultTitle'),
  description = t(locale, 'meta.defaultDescription'),
} = Astro.props;

const pathname = stripLocalePrefix(Astro.url.pathname);
const pathForLocale = pathname === '/' ? '' : pathname.replace(/^\//, '');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon+footer/favicon-32-creme-tegel.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/favicon+footer/favicon-512-creme-tegel.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>

    {locales.map((loc) => (
      <link
        rel="alternate"
        hreflang={loc}
        href={new URL(getRelativeLocaleUrl(loc, pathForLocale || undefined), Astro.site ?? Astro.url.origin).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localizePath('nl', pathname), Astro.site ?? Astro.url.origin).href}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,500&family=Nunito+Sans:wght@400;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Endorsely referral tracking -->
    <script async src="https://assets.endorsely.com/endorsely.js" data-endorsely="01f84354-5fb7-486d-aa6d-c0101799b3eb" is:inline></script>
  </head>
  <body>
    <SiteNotice />
    <div class="site-wrap">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  :root {
    --nav-height-desktop: 132px;
    --nav-height-mobile: 100px;
    --nav-height: var(--nav-height-desktop);
  }

  @media (max-width: 768px) {
    :root {
      --nav-height: var(--nav-height-mobile);
    }
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    font-family: 'Inter', system-ui, sans-serif;
    background-color: #F5F2EC;
    color: #1E293B;
    line-height: 1.6;
    min-height: 100vh;
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
  }

  /* Alle tekst breekt veilig af */
  h1, h2, h3, h4, h5, h6, p, li, a {
    overflow-wrap: break-word;
    word-break: break-word;
  }

  img, video {
    max-width: 100%;
    height: auto;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .site-wrap {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden;
    position: relative;
  }
</style>
